//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TICKERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var string ticker1 = syminfo.tickerid
var string ticker2 = ""
var string ticker3 = ""
var string ticker4 = ""

var bool inv2 = false
var bool inv3 = false
var bool inv4 = false

if barstate.isfirst
    if i_psp_mode == "Auto (Ronin)"
        [t2, t3, t4, i2, i3, i4] = f_get_ronin_correlation()

        ticker2 := t2
        ticker3 := t3
        ticker4 := t4

        inv2 := i2
        inv3 := i3
        inv4 := i4
    else
        ticker2 := i_psp_t2
        ticker3 := i_psp_t3
        inv3 := i_psp_inv3

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SESSION AUTO DETECTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

int current_d_time = time("D")

int auto_hr = not na(current_d_time) ? hour(current_d_time, "America/New_York") : 17
int auto_min = not na(current_d_time) ? minute(current_d_time, "America/New_York") : 0

int eff_hr = i_sess_mode == "Auto" ? auto_hr : i_daily_hr
int eff_min = i_sess_mode == "Auto" ? auto_min : i_daily_min

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DYNAMIC LOWER TIMEFRAME
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

string auto_base_tf = timeframe.in_seconds() < 900 ? timeframe.period : "15"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ARRAYS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var array<float> g_o15 = array.new<float>()
var array<float> g_h15 = array.new<float>()
var array<float> g_l15 = array.new<float>()
var array<float> g_c15 = array.new<float>()
var array<int> g_t15 = array.new<int>()

var array<float> g_o2 = array.new<float>()
var array<float> g_c2 = array.new<float>()
var array<int> g_t2 = array.new<int>()

var array<float> g_o3 = array.new<float>()
var array<float> g_c3 = array.new<float>()
var array<int> g_t3 = array.new<int>()

var array<float> g_o4 = array.new<float>()
var array<float> g_c4 = array.new<float>()
var array<int> g_t4 = array.new<int>()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LOWER TF DATA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[o15, h15, l15, c15, t15] = request.security_lower_tf(
     syminfo.tickerid,
     auto_base_tf,
     [open, high, low, close, time])

[o15_2, c15_2, t15_2] = request.security_lower_tf(
     ticker2 != "" ? ticker2 : syminfo.tickerid,
     auto_base_tf,
     [open, close, time],
     ignore_invalid_symbol=true)

[o15_3, c15_3, t15_3] = request.security_lower_tf(
     ticker3 != "" ? ticker3 : syminfo.tickerid,
     auto_base_tf,
     [open, close, time],
     ignore_invalid_symbol=true)

[o15_4, c15_4, t15_4] = request.security_lower_tf(
     ticker4 != "" ? ticker4 : syminfo.tickerid,
     auto_base_tf,
     [open, close, time],
     ignore_invalid_symbol=true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ARRAY HELPERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_push_arrays(arr_src, arr_dst) =>
    if array.size(arr_src) > 0
        for i = 0 to array.size(arr_src) - 1
            array.push(arr_dst, array.get(arr_src, i))

f_clip_arrays(arr) =>
    int max_bars = 5000

    if array.size(arr) > max_bars
        int excess = array.size(arr) - max_bars

        for i = 1 to excess
            array.shift(arr)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PUSH DATA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_push_arrays(o15, g_o15)
f_push_arrays(h15, g_h15)
f_push_arrays(l15, g_l15)
f_push_arrays(c15, g_c15)
f_push_arrays(t15, g_t15)

if ticker2 != ""
    f_push_arrays(o15_2, g_o2)
    f_push_arrays(c15_2, g_c2)
    f_push_arrays(t15_2, g_t2)

if ticker3 != ""
    f_push_arrays(o15_3, g_o3)
    f_push_arrays(c15_3, g_c3)
    f_push_arrays(t15_3, g_t3)

if ticker4 != ""
    f_push_arrays(o15_4, g_o4)
    f_push_arrays(c15_4, g_c4)
    f_push_arrays(t15_4, g_t4)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CLIP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_clip_arrays(g_o15)
f_clip_arrays(g_h15)
f_clip_arrays(g_l15)
f_clip_arrays(g_c15)
f_clip_arrays(g_t15)

f_clip_arrays(g_o2)
f_clip_arrays(g_c2)
f_clip_arrays(g_t2)

f_clip_arrays(g_o3)
f_clip_arrays(g_c3)
f_clip_arrays(g_t3)

f_clip_arrays(g_o4)
f_clip_arrays(g_c4)
f_clip_arrays(g_t4)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CUSTOM HTF AGGREGATOR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_get_custom_htf(
     int target_mins,
     array<int> arr_t,
     array<float> arr_o,
     array<float> arr_h,
     array<float> arr_l,
     array<float> arr_c) =>

    array<float> out_o = array.new<float>()
    array<float> out_h = array.new<float>()
    array<float> out_l = array.new<float>()
    array<float> out_c = array.new<float>()
    array<int> out_t = array.new<int>()

    int sz = array.size(arr_t)

    if sz > 0
        int last_htf_open = -1

        float cur_o = na
        float cur_h = na
        float cur_l = na
        float cur_c = na

        int cur_t = na

        for i = sz - 1 to 0
            int t = array.get(arr_t, i)

            int h_ny = hour(t, "America/New_York")
            int m_ny = minute(t, "America/New_York")

            int elapsed_mins_today = h_ny * 60 + m_ny
            int anchor_mins_today = eff_hr * 60 + eff_min

            int shift_mins = elapsed_mins_today - anchor_mins_today

            if shift_mins < 0
                shift_mins += 1440

            int htf_open_time = t - ((shift_mins % target_mins) * 60000)

            if htf_open_time != last_htf_open
                if last_htf_open != -1
                    array.push(out_o, cur_o)
                    array.push(out_h, cur_h)
                    array.push(out_l, cur_l)
                    array.push(out_c, cur_c)
                    array.push(out_t, cur_t)

                    if array.size(out_o) >= 5
                        break

                last_htf_open := htf_open_time

                cur_c := array.get(arr_c, i)
                cur_h := array.get(arr_h, i)
                cur_l := array.get(arr_l, i)
                cur_o := array.get(arr_o, i)
                cur_t := htf_open_time

            else
                cur_h := math.max(cur_h, array.get(arr_h, i))
                cur_l := math.min(cur_l, array.get(arr_l, i))
                cur_o := array.get(arr_o, i)

        if array.size(out_o) < 5 and last_htf_open != -1
            array.push(out_o, cur_o)
            array.push(out_h, cur_h)
            array.push(out_l, cur_l)
            array.push(out_c, cur_c)
            array.push(out_t, cur_t)

    while array.size(out_o) < 5
        array.push(out_o, na)
        array.push(out_h, na)
        array.push(out_l, na)
        array.push(out_c, na)
        array.push(out_t, na)

    [out_o, out_h, out_l, out_c, out_t]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CUSTOM HTF OC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_get_custom_htf_oc(
     int target_mins,
     array<int> arr_t,
     array<float> arr_o,
     array<float> arr_c) =>

    array<float> out_o = array.new<float>()
    array<float> out_c = array.new<float>()

    int sz = array.size(arr_t)

    if sz > 0
        int last_htf_open = -1

        float cur_o = na
        float cur_c = na

        for i = sz - 1 to 0
            int t = array.get(arr_t, i)

            int h_ny = hour(t, "America/New_York")
            int m_ny = minute(t, "America/New_York")

            int shift_mins = (h_ny * 60 + m_ny) - (eff_hr * 60 + eff_min)


            if shift_mins < 0
                shift_mins += 1440

            int htf_open_time = t - ((shift_mins % target_mins) * 60000)


            if htf_open_time != last_htf_open
                if last_htf_open != -1
                    array.push(out_o, cur_o)
                    array.push(out_c, cur_c)

                    if array.size(out_o) >= 5
                        break

                last_htf_open := htf_open_time

                cur_c := array.get(arr_c, i)
                cur_o := array.get(arr_o, i)

            else
                cur_o := array.get(arr_o, i)

        if array.size(out_o) < 5 and last_htf_open != -1
            array.push(out_o, cur_o)
            array.push(out_c, cur_c)

    while array.size(out_o) < 5
        array.push(out_o, na)
        array.push(out_c, na)

    [out_o, out_c]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PSP CALCULATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_calc_psp(
     array<float> os,
     array<float> hs,
     array<float> ls,
     array<float> cs,
     array<float> o2,
     array<float> c2,
     array<float> o3,
     array<float> c3,
     array<float> o4,
     array<float> c4) =>

    array<int> psp = array.new<int>(5, 0)

    int left = i_psp_left
    int right = i_psp_right

    for i = right to (4 - left)

        if na(os.get(i))
            continue

        bool is_ph = true

        for j = 1 to left
            if hs.get(i) <= hs.get(i + j)
                is_ph := false

        for j = 1 to right
            if hs.get(i) <= hs.get(i - j)
                is_ph := false

        bool is_pl = true

        for j = 1 to left
            if ls.get(i) >= ls.get(i + j)
                is_pl := false

        for j = 1 to right
            if ls.get(i) >= ls.get(i - j)
                is_pl := false

        if is_ph or is_pl

            bool b1 = cs.get(i) >= os.get(i)
            bool crack = false

            if ticker2 != "" and array.size(o2) > i and not na(o2.get(i))
                bool b2 = c2.get(i) >= o2.get(i)

                if inv2
                    b2 := not b2

                if b1 != b2
                    crack := true

            if ticker3 != "" and array.size(o3) > i and not na(o3.get(i))
                bool b3 = c3.get(i) >= o3.get(i)

                if inv3
                    b3 := not b3

                if b1 != b3
                    crack := true

            if ticker4 != "" and array.size(o4) > i and not na(o4.get(i))
                bool b4 = c4.get(i) >= o4.get(i)

                if inv4
                    b4 := not b4

                if b1 != b4
                    crack := true

            if crack
                if is_ph
                    psp.set(i, 1)

                if is_pl
                    psp.set(i, 2)

    psp

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VALID HTF
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

isValidHTF() =>
    not na(activeTfSeconds) and
     timeframe.in_seconds(timeframe.period) <= activeTfSeconds

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MAP ONLY ONE ACTIVE HTF
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

array<float> active_o_arr = array.new<float>()
array<float> active_h_arr = array.new<float>()
array<float> active_l_arr = array.new<float>()
array<float> active_c_arr = array.new<float>()
array<int> active_t_arr = array.new<int>()

array<float> active_o2 = array.new<float>()
array<float> active_c2 = array.new<float>()

array<float> active_o3 = array.new<float>()
array<float> active_c3 = array.new<float>()

array<float> active_o4 = array.new<float>()
array<float> active_c4 = array.new<float>()

array<int> psp_active = array.new<int>(5, 0)

if not na(activeTfMinutes)
    [tmp_o, tmp_h, tmp_l, tmp_c, tmp_t] = f_get_custom_htf(activeTfMinutes, g_t15, g_o15, g_h15, g_l15, g_c15)


    active_o_arr := tmp_o
    active_h_arr := tmp_h
    active_l_arr := tmp_l
    active_c_arr := tmp_c
    active_t_arr := tmp_t

    [tmp_o2, tmp_c2] =
         f_get_custom_htf_oc(
             activeTfMinutes,
             g_t2,
             g_o2,
             g_c2)

    [tmp_o3, tmp_c3] =
         f_get_custom_htf_oc(
             activeTfMinutes,
             g_t3,
             g_o3,
             g_c3)

    [tmp_o4, tmp_c4] =
         f_get_custom_htf_oc(
             activeTfMinutes,
             g_t4,
             g_o4,
             g_c4)

    active_o2 := tmp_o2
    active_c2 := tmp_c2

    active_o3 := tmp_o3
    active_c3 := tmp_c3

    active_o4 := tmp_o4
    active_c4 := tmp_c4

    psp_active :=
         i_psp_show ?
         f_calc_psp(
             active_o_arr,
             active_h_arr,
             active_l_arr,
             active_c_arr,
             active_o2,
             active_c2,
             active_o3,
             active_c3,
             active_o4,
             active_c4) :
         array.new<int>(5, 0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GET FIVE ACTIVE HTF CANDLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

float o0 = array.get(active_o_arr, 0)
float h0 = array.get(active_h_arr, 0)
float l0 = array.get(active_l_arr, 0)
float c0 = array.get(active_c_arr, 0)
int t0 = array.get(active_t_arr, 0)

float o1 = array.get(active_o_arr, 1)
float h1 = array.get(active_h_arr, 1)
float l1 = array.get(active_l_arr, 1)
float c1 = array.get(active_c_arr, 1)
int t1 = array.get(active_t_arr, 1)

float o2 = array.get(active_o_arr, 2)
float h2 = array.get(active_h_arr, 2)
float l2 = array.get(active_l_arr, 2)
float c2 = array.get(active_c_arr, 2)
int t2 = array.get(active_t_arr, 2)

float o3 = array.get(active_o_arr, 3)
float h3 = array.get(active_h_arr, 3)
float l3 = array.get(active_l_arr, 3)
float c3 = array.get(active_c_arr, 3)
int t3 = array.get(active_t_arr, 3)

float o4 = array.get(active_o_arr, 4)
float h4 = array.get(active_h_arr, 4)
float l4 = array.get(active_l_arr, 4)
float c4 = array.get(active_c_arr, 4)
int t4 = array.get(active_t_arr, 4)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRACE INDEX
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var int idx_active = bar_index

if t0 != t0[1]
    idx_active := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAWING STORAGE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var array<box> g_bodies = array.new<box>()
var array<line> g_wicks_up = array.new<line>()
var array<line> g_wicks_dn = array.new<line>()
var array<box> g_fvgs = array.new<box>()
var array<line> g_sweeps = array.new<line>()
var array<line> g_mids = array.new<line>()
var array<label> g_timelabels = array.new<label>()
var array<line> g_traces = array.new<line>()

var label g_lbl_active = na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MIDPOINT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

calcMidpoint(
     float h,
     float l,
     float o,
     float c) =>

    float lh = math.log(h)
    float ll = math.log(l)
    float lo = math.log(o)
    float lc = math.log(c)

    float uw = lh - math.max(lo, lc)
    float lw = math.min(lo, lc) - ll
    float bs = math.abs(lc - lo)

    float lmid = math.max(uw, lw) > bs ? (uw > lw ? lh - uw / 2 : ll + lw / 2) : (lh + ll) / 2


    math.exp(lmid)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TIME FORMAT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

formatTime(int t) =>
    str.format_time(
         t,
         "HH:mm",
         "America/New_York")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// REMAINING TIME
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

remainingCustomTime(
     int openTime,
     int target_mins) =>

    if barstate.isrealtime and not na(openTime)

        int closeTime =
             openTime + target_mins * 60000

        int rem = math.max(0, int((closeTime - timenow) / 1000))


        if rem == 0
            "00:00"

        else

            int d = int(rem / 86400)

            int h =
                 int(
                     (rem - d * 86400) / 3600)

            int m =
                 int(
                     (rem - d * 86400 - h * 3600) / 60)

            int s =
                 int(
                     rem -
                     d * 86400 -
                     h * 3600 -
                     m * 60)

            string r =
                 str.tostring(s, "00")

            if m > 0 or h > 0 or d > 0
                r :=
                     str.tostring(m, "00") +
                     ":" +
                     r

            if h > 0 or d > 0
                r :=
                     str.tostring(h, "00") +
                     ":" +
                     r

            if d > 0
                r :=
                     str.tostring(d) +
                     "D " +
                     r

            r

    else
        "n/a"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW TRACES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_draw_traces(
     int start_idx,
     float o,
     float h,
     float l,
     float c,
     int newest_x1,
     int newest_xm) =>

    if i_trace_show

        if i_trace_o
            g_traces.push(
                 line.new(
                     start_idx,
                     o,
                     newest_x1,
                     o,
                     color=i_trace_o_col,
                     style=get_line_style2(i_trace_o_sty)))

        if i_trace_c
            g_traces.push(
                 line.new(
                     start_idx,
                     c,
                     newest_x1,
                     c,
                     color=i_trace_c_col,
                     style=get_line_style2(i_trace_c_sty)))

        if i_trace_h
            g_traces.push(
                 line.new(
                     start_idx,
                     h,
                     newest_xm,
                     h,
                     color=i_trace_h_col,
                     style=get_line_style2(i_trace_h_sty)))

        if i_trace_l
            g_traces.push(
                 line.new(
                     start_idx,
                     l,
                     newest_xm,
                     l,
                     color=i_trace_l_col,
                     style=get_line_style2(i_trace_l_sty)))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DELETE ALL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

deleteAll() =>

    int i = 0

    while i < g_bodies.size()
        box.delete(g_bodies.get(i))
        i += 1

    g_bodies.clear()

    i := 0

    while i < g_wicks_up.size()
        line.delete(g_wicks_up.get(i))
        i += 1

    g_wicks_up.clear()

    i := 0

    while i < g_wicks_dn.size()
        line.delete(g_wicks_dn.get(i))
        i += 1

    g_wicks_dn.clear()

    i := 0

    while i < g_fvgs.size()
        box.delete(g_fvgs.get(i))
        i += 1

    g_fvgs.clear()

    i := 0

    while i < g_sweeps.size()
        line.delete(g_sweeps.get(i))
        i += 1

    g_sweeps.clear()

    i := 0

    while i < g_mids.size()
        line.delete(g_mids.get(i))
        i += 1

    g_mids.clear()

    i := 0

    while i < g_timelabels.size()
        label.delete(g_timelabels.get(i))
        i += 1

    g_timelabels.clear()

    while g_traces.size() > 0
        line.delete(g_traces.pop())

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW CANDLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

drawCandle(
     float o,
     float h,
     float l,
     float c,
     int t,
     int slot,
     int startOff,
     TFColors col,
     int psp_status) =>

    int x1 =
         bar_index +
         startOff +
         slot * (i_width + i_buffer)

    int x2 =
         x1 + i_width

    int xm =
         x1 + i_width / 2

    bool bull =
         c >= o

    color b_col =
         bull ?
         col.bull_body :
         col.bear_body

    if psp_status == 1
        b_col := i_psp_bear_col
    else if psp_status == 2
        b_col := i_psp_bull_col

    box bd =
         box.new(
             x1,
             math.max(o, c),
             x2,
             math.min(o, c),
             border_color=bull ? col.bull_border : col.bear_border,
             border_width=1,
             bgcolor=b_col)

    line wu =
         line.new(
             xm,
             h,
             xm,
             math.max(o, c),
             color=bull ? col.bull_wick : col.bear_wick)

    line wd =
         line.new(
             xm,
             math.min(o, c),
             xm,
             l,
             color=bull ? col.bull_wick : col.bear_wick)

    g_bodies.push(bd)
    g_wicks_up.push(wu)
    g_wicks_dn.push(wd)

    if i_show_time and not na(t)

        label tl =
             label.new(
                 xm,
                 l,
                 formatTime(t),
                 color=transparent,
                 textcolor=i_time_color,
                 style=label.style_label_up,
                 size=size.small,
                 text_font_family=font.family_monospace)

        g_timelabels.push(tl)

    [x1, x2, h, l]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW BLOCK
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

drawBlock(
     float o0,
     float h0,
     float l0,
     float c0,
     int t0,

     float o1,
     float h1,
     float l1,
     float c1,
     int t1,

     float o2,
     float h2,
     float l2,
     float c2,
     int t2,

     float o3,
     float h3,
     float l3,
     float c3,
     int t3,

     float o4,
     float h4,
     float l4,
     float c4,
     int t4,

     array<int> psp_arr,
     int startOff,
     int n,
     TFColors col) =>

    array<float> os =
         array.from(o4, o3, o2, o1, o0)

    array<float> hs =
         array.from(h4, h3, h2, h1, h0)

    array<float> ls =
         array.from(l4, l3, l2, l1, l0)

    array<float> cs =
         array.from(c4, c3, c2, c1, c0)

    array<int> ts =
         array.from(t4, t3, t2, t1, t0)

    int si = 5 - n

    array<int> xs1 = array.new<int>()
    array<int> xs2 = array.new<int>()
    array<float> chs = array.new<float>()
    array<float> cls = array.new<float>()
    array<float> cos = array.new<float>()
    array<float> ccs = array.new<float>()

    float blockHigh = 0.0

    int slot = 0

    while slot < n

        int idx = si + slot

        float co = os.get(idx)
        float ch = hs.get(idx)
        float cl = ls.get(idx)
        float cc = cs.get(idx)

        int ct = ts.get(idx)

        int p_idx = 4 - idx

        int psp_status =
             psp_arr.get(p_idx)

        if not na(co)

            [x1, x2, cvh, cvl] =
                 drawCandle(
                     co,
                     ch,
                     cl,
                     cc,
                     ct,
                     slot,
                     startOff,
                     col,
                     psp_status)

            xs1.push(x1)
            xs2.push(x2)

            chs.push(ch)
            cls.push(cl)

            cos.push(co)
            ccs.push(cc)

            if ch > blockHigh
                blockHigh := ch

        slot += 1

    int drawn = xs1.size()

    // MIDPOINTS

    if i_mid_show and drawn >= 2

        int i = 0

        while i < drawn - 1

            float mid =
                 calcMidpoint(
                     chs.get(i),
                     cls.get(i),
                     cos.get(i),
                     ccs.get(i))

            int mx1 =
                 xs1.get(i) +
                 i_width / 2

            int mx2 =
                 xs1.get(i + 1) +
                 i_width / 2

            g_mids.push(
                 line.new(
                     mx1,
                     mid,
                     mx2,
                     mid,
                     color=i_mid_color,
                     style=line.style_dotted,
                     width=1))

            i += 1

    // SWEEPS

    if i_sweep_show and drawn >= 2

        int i = 0

        while i < drawn - 1

            float ph = chs.get(i)
            float pl = cls.get(i)

            float nh = chs.get(i + 1)
            float nl = cls.get(i + 1)

            float nc = ccs.get(i + 1)

            int sx1 =
                 xs1.get(i) +
                 i_width / 2

            int sx2 =
                 xs2.get(i + 1)

            if nh > ph and nc < ph

                g_sweeps.push(
                     line.new(
                         sx1,
                         ph,
                         sx2,
                         ph,
                         color=i_sweep_color,
                         width=1))

            if nl < pl and nc > pl

                g_sweeps.push(
                     line.new(
                         sx1,
                         pl,
                         sx2,
                         pl,
                         color=i_sweep_color,
                         width=1))

            i += 1

    // FVG

    if i_fvg_show and drawn >= 3

        int i = 0

        while i < drawn - 2

            float h1f = chs.get(i)
            float l1f = cls.get(i)

            float h3f = chs.get(i + 2)
            float l3f = cls.get(i + 2)

            int fx1 = xs1.get(i)
            int fx2 = xs2.get(i + 2)

            if l1f > h3f

                g_fvgs.push(
                     box.new(
                         fx1,
                         l1f,
                         fx2,
                         h3f,
                         bgcolor=i_fvg_color,
                         border_color=transparent))

            if h1f < l3f

                g_fvgs.push(
                     box.new(
                         fx1,
                         l3f,
                         fx2,
                         h1f,
                         bgcolor=i_fvg_color,
                         border_color=transparent))

            i += 1

    int totalW = n * i_width + math.max(0, n - 1) * i_buffer
    int centerX = bar_index + startOff + totalW / 2
    int nextOff = startOff + totalW + i_buffer

    [centerX, blockHigh, nextOff]


//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COLOR OBJECT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

TFColors col_active =
     TFColors.new(
         i_htf_bull_body,
         i_htf_bear_body,
         i_htf_bull_border,
         i_htf_bear_border,
         i_htf_bull_wick,
         i_htf_bear_wick)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MAIN DRAW
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if barstate.islast

    deleteAll()

    int n =
         math.min(
             i_maxshow,
             5)

    int off =
         i_offset

    if isValidHTF()

        [cx, top, nextOff] =
             drawBlock(
                 o0,
                 h0,
                 l0,
                 c0,
                 t0,

                 o1,
                 h1,
                 l1,
                 c1,
                 t1,

                 o2,
                 h2,
                 l2,
                 c2,
                 t2,

                 o3,
                 h3,
                 l3,
                 c3,
                 t3,

                 o4,
                 h4,
                 l4,
                 c4,
                 t4,

                 psp_active,
                 off,
                 n,
                 col_active)

        // TRACE

        int newest_x1 =
             bar_index +
             off +
             (n - 1) *
             (i_width + i_buffer)

        f_draw_traces(
             idx_active,
             o0,
             h0,
             l0,
             c0,
             newest_x1,
             newest_x1 + i_width / 2)

        // LABEL

        if i_show_label

            string modeText =
                 qtAlignment ?
                 "QT" :
                 "ICT"

            string txt =
                 "TF: " +
                 crtFormatTF(activeTimeframe) +
                 " [" +
                 modeText +
                 "]" +
                 (i_show_timer ?
                      "\n[" +
                      remainingCustomTime(
                          t0,
                          activeTfMinutes) +
                      "]" :
                      "")

            if na(g_lbl_active)

                g_lbl_active :=
                     label.new(
                         cx,
                         top,
                         txt,
                         color=transparent,
                         textcolor=i_label_color,
                         style=label.style_label_down,
                         size=i_label_size,
                         text_font_family=font.family_monospace)

            else

                label.set_xy(
                     g_lbl_active,
                     cx,
                     top)

                label.set_text(
                     g_lbl_active,
                     txt)

        off := nextOff
