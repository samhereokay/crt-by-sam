            inv3 := true

        "GBPUSD" =>
            t2 := f_get_ticker("EURUSD")
            inv2 := false
            t3 := "TVC:DXY"
            inv3 := true

        "AUDUSD" =>
            t2 := f_get_ticker("NZDUSD")
            inv2 := false
            t3 := "TVC:DXY"
            inv3 := true

        "NZDUSD" =>
            t2 := f_get_ticker("AUDUSD")
            inv2 := false
            t3 := "TVC:DXY"
            inv3 := true

        "USDJPY" =>
            t2 := "TVC:DXY"
            inv2 := false

        "USDCAD" =>
            t2 := "TVC:DXY"
            inv2 := false

        "USDCHF" =>
            t2 := "TVC:DXY"
            inv2 := false

        "EURJPY" =>
            t2 := f_get_ticker("GBPJPY")
            inv2 := false

        "GBPJPY" =>
            t2 := f_get_ticker("EURJPY")
            inv2 := false

        "AUDJPY" =>
            t2 := f_get_ticker("NZDJPY")
            inv2 := false

        "NZDJPY" =>
            t2 := f_get_ticker("AUDJPY")
            inv2 := false

        "EURAUD" =>
            t2 := f_get_ticker("GBPAUD")
            inv2 := false

        "GBPAUD" =>
            t2 := f_get_ticker("EURAUD")
            inv2 := false

        "EURNZD" =>
            t2 := f_get_ticker("GBPNZD")
            inv2 := false

        "GBPNZD" =>
            t2 := f_get_ticker("EURNZD")
            inv2 := false

        "EURCAD" =>
            t2 := f_get_ticker("GBPCAD")
            inv2 := false

        "GBPCAD" =>
            t2 := f_get_ticker("EURCAD")
            inv2 := false

        "AUDCAD" =>
            t2 := f_get_ticker("NZDCAD")
            inv2 := false

        "NZDCAD" =>
            t2 := f_get_ticker("AUDCAD")
            inv2 := false

        "BTCUSDT" =>
            t2 := f_get_ticker("ETHUSDT")
            inv2 := false

