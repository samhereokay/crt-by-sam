//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TYPE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

type TFColors
    color bull_body
    color bear_body
    color bull_border
    color bear_border
    color bull_wick
    color bear_wick

color transparent = #ffffff00

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LINE STYLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

getLineStyle(string style) =>
    switch style
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

get_line_style2(string s) =>
    s == "----" ? line.style_dashed : s == "····" ? line.style_dotted : line.style_solid

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ICT MAPPING
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

auto_map_tf(int chartSeconds) =>
    switch chartSeconds
        60 => "15"
        180 => "30"
        300 => "60"
        900 => "240"
        1800 => "180"
        3600 => "D"
        7200 => "D"
        10800 => "W"
        14400 => "W"
        86400 => "1M"
        604800 => "1M"
        => na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// QT MAPPING
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

getHigherTimeframe(int chartSeconds) =>
    switch chartSeconds
        60 => "15"
        180 => "30"
        300 => "90"
        900 => "360"
        1800 => "360"
        3600 => "360"
        7200 => "D"
        10800 => "W"
        14400 => "W"
        86400 => "1M"
        604800 => "1M"
        => na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// AUTOMATIC HTF
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

chartTfSeconds = timeframe.in_seconds(timeframe.period)

activeTimeframe = qtAlignment ? getHigherTimeframe(chartTfSeconds) : auto_map_tf(chartTfSeconds)

activeTfSeconds = not na(activeTimeframe) ? timeframe.in_seconds(activeTimeframe) : na

activeTfMinutes = not na(activeTfSeconds) ? int(activeTfSeconds / 60) : na

// Display-only formatter: turns Pine's raw timeframe strings ("360", "90",
// "D", "1M"...) into readable labels ("6H", "90m", "1D", "1M"...) for the
// HTF-candle label and the dashboard header. `activeTimeframe` itself is
// left untouched everywhere else since the switch logic elsewhere compares
// against the raw Pine strings.
crtFormatTF(string _tf) =>
    string _out = _tf
    if _tf == "D" or _tf == "W"
        _out := "1" + _tf
    else if str.contains(_tf, "M")
        // Already readable: "1M", "3M", "12M" (monthly timeframes)
        _out := _tf
    else
        float _minsF = str.tonumber(_tf)
        if not na(_minsF)
            int _mins = int(_minsF)
            _out := _mins < 60 ? str.tostring(_mins) + "m" : _mins % 60 == 0 ? str.tostring(int(_mins / 60)) + "H" : str.tostring(_mins) + "m"
    _out

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DRAW PERIOD SEPARATOR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

drawPeriodSeparator(
     color colorInput,
     string styleInput,
     int widthInput,
     string tf) =>

    if timeframe.change(tf)
        line.new(
             x1=bar_index,
             x2=bar_index,
             y1=high + syminfo.mintick,
             y2=low,
             extend=extend.both,
             color=colorInput,
             style=getLineStyle(styleInput),
             width=widthInput)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SEPARATOR DRAW
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if not na(activeTimeframe) and not na(activeTfSeconds)
    if timeframe.in_seconds(timeframe.period) <= activeTfSeconds
        drawPeriodSeparator(
             sepColorInput,
             sepStyleInput,
             sepWidthInput,
             activeTimeframe)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RONIN CORRELATION ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_get_ticker(string simple_name) =>
    if simple_name == "DXY"
        "TVC:DXY"
    else if simple_name == "US10Y"
        "TVC:US10Y"
    else
        syminfo.prefix + ":" + simple_name

f_get_ronin_correlation() =>
    string t2 = ""
    string t3 = ""
    string t4 = ""
    bool inv2 = false
    bool inv3 = false
    bool inv4 = false

    string check_sym = syminfo.root != "" ? syminfo.root : syminfo.ticker

    switch check_sym
        "XAUUSD" =>
            t2 := f_get_ticker("XAGUSD")
            inv2 := false
            t3 := f_get_ticker("XAUEUR")
            inv3 := false
            t4 := f_get_ticker("XAUGBP")
            inv4 := false

        "XAUEUR" =>
            t2 := f_get_ticker("XAUUSD")
            inv2 := false
            t3 := f_get_ticker("XAUGBP")
            inv3 := false

        "XAUGBP" =>
            t2 := f_get_ticker("XAUUSD")
            inv2 := false
            t3 := f_get_ticker("XAUEUR")
            inv3 := false

        "XAGUSD" =>
            t2 := f_get_ticker("XAUUSD")
            inv2 := false
            t3 := f_get_ticker("XAUEUR")
            inv3 := false

        "RB" =>
            t2 := "HO1!"
            inv2 := false
            t3 := "CL1!"
            inv3 := false

        "HO" =>
            t2 := "RB1!"
            inv2 := false
            t3 := "CL1!"
            inv3 := false

        "CL" =>
            t2 := "HO1!"
            inv2 := false
            t3 := "RB1!"
            inv3 := false

        "MNQ" =>
            t2 := "MES1!"
            inv2 := false
            t3 := "MYM1!"
            inv3 := false

        "MES" =>
            t2 := "MNQ1!"
            inv2 := false
            t3 := "MYM1!"
            inv3 := false

        "MYM" =>
            t2 := "MES1!"
            inv2 := false
            t3 := "MNQ1!"
            inv3 := false

        "NQ" =>
            t2 := "ES1!"
            inv2 := false
            t3 := "YM1!"
            inv3 := false

        "ES" =>
            t2 := "NQ1!"
            inv2 := false
            t3 := "YM1!"
            inv3 := false

        "YM" =>
            t2 := "ES1!"
            inv2 := false
            t3 := "NQ1!"
            inv3 := false

        "GC" =>
            t2 := "SI1!"
            inv2 := false
            t3 := "NQ1!"
            inv3 := false

        "NASDAQ" =>
            t2 := "PEPPERSTONE:US500"
            inv2 := false
            t3 := "PEPPERSTONE:US30"
            inv3 := false

        "NDAQ100" =>
            t2 := "PEPPERSTONE:US500"
            inv2 := false
            t3 := "PEPPERSTONE:US30"
            inv3 := false

        "NAS100" =>
            t2 := "PEPPERSTONE:US500"
            inv2 := false
            t3 := "PEPPERSTONE:US30"
            inv3 := false

        "SPX500" =>
            t2 := "PEPPERSTONE:NAS100"
            inv2 := false
            t3 := "PEPPERSTONE:US30"
            inv3 := false

        "US500" =>
            t2 := "PEPPERSTONE:NAS100"
            inv2 := false
            t3 := "PEPPERSTONE:US30"
            inv3 := false

        "US30" =>
            t2 := "PEPPERSTONE:NAS100"
            inv2 := false
            t3 := "PEPPERSTONE:US500"
            inv3 := false

        "DJI" =>
            t2 := "PEPPERSTONE:NAS100"
            inv2 := false
            t3 := "PEPPERSTONE:US500"
            inv3 := false

        "WALLSTREET" =>
            t2 := "PEPPERSTONE:NAS100"
            inv2 := false
            t3 := "PEPPERSTONE:US500"
            inv3 := false

        "EURUSD" =>
            t2 := f_get_ticker("GBPUSD")
            inv2 := false
