qtAlignmentInput = input.bool(
     false,
     "QT Alignment",
     group=g_mode,
     tooltip="OFF = ICT alignment. ON = QT alignment. ICT and QT are mutually exclusive."
)

// Strict inverse: exactly one alignment is active at all times.
