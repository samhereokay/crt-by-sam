//==============================================================================
// Time declarations and GXV auto timezone/session helpers
//==============================================================================
tf = timeframe.period
tf_sec = timeframe.in_seconds(tf)
f_is_mid_prefix(string px) =>
    px == "CAPITALCOM" or px == "CMCMARKETS"

f_is_chicago_prefix(string px) =>
    px == "CME" or px == "CBOT" or px == "CBOT_MINI" or px == "CBOT_DL" or px == "CME_MINI" or px == "CME_DL" or px == "CME_MINI_DL" or px == "COMEX" or px == "NYMEX"

f_is_utc_prefix(string px) =>
    px == "BINANCE" or px == "BYBIT" or px == "KRAKEN" or px == "GATE.IO" or px == "BITSTAMP" or px == "COINBASE" or px == "GEMINI"

f_oracle_tz(string px) =>
    f_is_chicago_prefix(px) ? "America/Chicago" : f_is_mid_prefix(px) ? "Etc/GMT+5" : f_is_utc_prefix(px) ? "UTC" : "America/New_York"

f_oracle_day_start_hour(string px) =>
    f_is_chicago_prefix(px) or f_is_mid_prefix(px) ? 17 : f_is_utc_prefix(px) ? 22 : 18

f_days_since_sunday(int dow) =>
    dow == dayofweek.sunday ? 0 : dow == dayofweek.monday ? 1 : dow == dayofweek.tuesday ? 2 : dow == dayofweek.wednesday ? 3 : dow == dayofweek.thursday ? 4 : dow == dayofweek.friday ? 5 : 6

f_smt_anchor_range_key(int barTime, int anchorTime, int rangeMinutes) =>
    int rangeMs = rangeMinutes * 60 * 1000
    int bucket = int(math.floor((barTime - anchorTime) / rangeMs))
    anchorTime + bucket * rangeMs

f_smt_daily_range_key(int dayStartTime) =>
    dayStartTime

f_smt_iso_week_year(int refTime, string tz) =>
    int wy = year(refTime, tz)
    int wm = month(refTime, tz)
    int cw = weekofyear(refTime, tz)
    if wm == 12 and cw == 1
        wy := wy + 1
    else if wm == 1 and cw >= 52
        wy := wy - 1
    wy

f_smt_iso_week_range_key(int dayStartTime, int oneDayMs, string tz) =>
    int refTime = dayStartTime + oneDayMs
    int wy = f_smt_iso_week_year(refTime, tz)
    int cw = weekofyear(refTime, tz)
    wy * 100 + cw

f_smt_month_range_key(int dayStartTime, string tz) =>
    year(dayStartTime, tz) * 100 + month(dayStartTime, tz)

f_smt_month_of_quarter_slot(int dayStartTime, string tz) =>
    int cm = month(dayStartTime, tz)
    int qsM = int(math.floor((cm - 1) / 3)) * 3 + 1
    cm - qsM

f_smt_month_of_quarter_range_key(int dayStartTime, string tz) =>
    int cy = year(dayStartTime, tz)
    int cm = month(dayStartTime, tz)
    int q = int(math.floor((cm - 1) / 3)) + 1
    int slot = f_smt_month_of_quarter_slot(dayStartTime, tz)
    cy * 100 + q * 10 + slot

f_smt_quarter_subrange_slot(int barTime, int dayStartTime, string tz, int startHour) =>
    int cy = year(dayStartTime, tz)
    int cm = month(dayStartTime, tz)
    int qsM = int(math.floor((cm - 1) / 3)) * 3 + 1
    int qsT = timestamp(tz, cy, qsM, 1, startHour, 0)
    int qeT = qsM == 10 ? timestamp(tz, cy + 1, 1, 1, startHour, 0) : timestamp(tz, cy, qsM + 3, 1, startHour, 0)
    int q = int(math.floor((barTime - qsT) * 4.0 / math.max(1, qeT - qsT)))
    math.max(0, math.min(3, q))

f_smt_quarter_subrange_key(int barTime, int dayStartTime, string tz, int startHour) =>
    int cy = year(dayStartTime, tz)
    int cm = month(dayStartTime, tz)
    int quarter = int(math.floor((cm - 1) / 3)) + 1
    int slot = f_smt_quarter_subrange_slot(barTime, dayStartTime, tz, startHour)
    cy * 100 + quarter * 10 + slot

f_smt_four_year_phase(int y) =>
    y % 4 == 3 ? 0 : y % 4 == 0 ? 1 : y % 4 == 1 ? 2 : 3

f_smt_four_year_range_key(int barTime, string tz) =>
    int y = year(barTime, tz)
    int block = int(math.floor(y / 4))
    block * 10 + f_smt_four_year_phase(y)

f_smt_local_day_start(int barTime, string tz, int startHour) =>
    int localYear = year(barTime, tz)
    int localMonth = month(barTime, tz)
    int localDay = dayofmonth(barTime, tz)
    int todayStart = timestamp(tz, localYear, localMonth, localDay, startHour, 0)
    int previousDayProbe = barTime - 24 * 60 * 60 * 1000
    barTime >= todayStart ? todayStart : timestamp(tz, year(previousDayProbe, tz), month(previousDayProbe, tz), dayofmonth(previousDayProbe, tz), startHour, 0)

f_smt_shift_local_day_start(int sourceDayStart, int daysBack, string tz, int startHour) =>
    int shiftedProbe = sourceDayStart - daysBack * 24 * 60 * 60 * 1000
    timestamp(tz, year(shiftedProbe, tz), month(shiftedProbe, tz), dayofmonth(shiftedProbe, tz), startHour, 0)

px = syminfo.prefix
oracle_tz = f_oracle_tz(px)
dayStartHour = f_oracle_day_start_hour(px)
msDay = 24 * 60 * 60 * 1000
dayStart = f_smt_local_day_start(time, oracle_tz, dayStartHour)
dayStartDow = dayofweek(dayStart, oracle_tz)
weeklyCycleAnchor = f_smt_shift_local_day_start(dayStart, f_days_since_sunday(dayStartDow), oracle_tz, dayStartHour)

// GXV deterministic range keys.
val_ses15 = f_smt_anchor_range_key(time, dayStart, 15)
val_ses30 = f_smt_anchor_range_key(time, dayStart, 30)
val_ses180 = f_smt_anchor_range_key(time, dayStart, 180)
val_ses90 = f_smt_anchor_range_key(time, dayStart, 90)
val_ses60 = f_smt_anchor_range_key(time, dayStart, 60)
val_ses240 = f_smt_anchor_range_key(time, dayStart, 240)
val_sesD = f_smt_anchor_range_key(time, dayStart, 360)
val_ses420 = f_smt_anchor_range_key(time, weeklyCycleAnchor, 420)
val_ses720 = f_smt_anchor_range_key(time, dayStart, 720)
val_sesW = f_smt_daily_range_key(dayStart)
val_sesM = f_smt_iso_week_range_key(dayStart, msDay, oracle_tz)
val_sesMT = f_smt_month_of_quarter_range_key(dayStart, oracle_tz)
val_sesQ = f_smt_quarter_subrange_key(time, dayStart, oracle_tz, dayStartHour)
val_sesY = f_smt_four_year_range_key(time, "America/New_York")

// GXV chart-timeframe gates — hardcoded stable reconstruction-safe gates.
const int TF_SEC_1 = 60
const int TF_SEC_3 = 3 * TF_SEC_1
const int TF_SEC_5 = 5 * TF_SEC_1
const int TF_SEC_15 = 15 * TF_SEC_1
const int TF_SEC_30 = 30 * TF_SEC_1
const int TF_SEC_60 = 60 * TF_SEC_1
const int TF_SEC_180 = 180 * TF_SEC_1
const int TF_SEC_240 = 240 * TF_SEC_1
const int TF_SEC_360 = 360 * TF_SEC_1
const int TF_SEC_D = 24 * 60 * 60
const int TF_SEC_M = 30 * TF_SEC_D

SMT_GATE_15M = TF_SEC_5
SMT_GATE_30M = TF_SEC_5
SMT_GATE_3H = TF_SEC_15
SMT_GATE_90M = TF_SEC_15
SMT_GATE_1H = TF_SEC_15
SMT_GATE_4H = TF_SEC_60
SMT_GATE_6H = TF_SEC_60
SMT_GATE_7H = TF_SEC_60
SMT_GATE_12H = TF_SEC_240
SMT_GATE_1D = TF_SEC_240
SMT_GATE_1W = TF_SEC_360
SMT_GATE_1M = TF_SEC_360
SMT_GATE_3M = TF_SEC_D
SMT_GATE_12M = TF_SEC_M
tf_ok_15m = tf_sec <= SMT_GATE_15M
tf_ok_30m = tf_sec <= SMT_GATE_30M
tf_ok_3h = tf_sec <= SMT_GATE_3H
tf_ok_90m = tf_sec <= SMT_GATE_90M
tf_ok_1h = tf_sec <= SMT_GATE_1H
tf_ok_4h = tf_sec <= SMT_GATE_4H
tf_ok_6h = tf_sec <= SMT_GATE_6H
tf_ok_7h = tf_sec <= SMT_GATE_7H
tf_ok_12h = tf_sec <= SMT_GATE_12H
tf_ok_1d = tf_sec <= SMT_GATE_1D
tf_ok_1w = tf_sec <= SMT_GATE_1W
tf_ok_1m = tf_sec <= SMT_GATE_1M
tf_ok_3m = tf_sec <= SMT_GATE_3M
tf_ok_12m = tf_sec <= SMT_GATE_12M

// Monthly SMT minimum chart-timeframe render policy.
// Display authority only: existing SMT compute gates and lifecycle state remain unchanged.
f_smt_monthly_tf_render_ok(int rank) =>
    bool isMonthlyRank = rank == 11 or rank == 12 or rank == 13
    int minTfSec = smt_monthly_min_tf == "1 Hour" ? TF_SEC_60 : smt_monthly_min_tf == "4 Hour" ? TF_SEC_240 : smt_monthly_min_tf == "1 Day" ? TF_SEC_D : 0
    not isMonthlyRank or minTfSec == 0 or tf_sec >= minTfSec


//==============================================================================
// GXV AssetCorrelationUtils bridge
type SmtCorrelationDescriptor
    string symbol
    string displayName
    bool inverse
    bool configured
    bool dataReady
    float sourceHigh
    float sourceLow
    int sourceTime

//==============================================================================
const string INVALID_SECONDARY = "__GXV_SMT_INVALID_SECONDARY__"
const string INVALID_TERTIARY = "__GXV_SMT_INVALID_TERTIARY__"
const string INVALID_QUATERNARY = "__GXV_SMT_INVALID_QUATERNARY__"

f_has_symbol(string s) =>
    str.length(s) > 0

f_asset_token(string s) =>
    array<string> parts = str.split(s, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : s

f_same_symbol(string a, string b) =>
    str.upper(a) == str.upper(b) or str.upper(f_asset_token(a)) == str.upper(f_asset_token(b))

string csym = ""
string tsym3 = ""
string qsym4 = ""
bool corr_base_ok = false
bool corr_has_tertiary = false
bool corr_has_quaternary = false
bool corr_pair1_ok = false
bool corr_pair2_ok = false
bool corr_pair3_ok = false
bool corr_pair1_configured = false
bool corr_pair2_configured = false
bool corr_pair3_configured = false
bool corr_inv1 = false
bool corr_inv2 = false
bool corr_inv3 = false
bool corr_type_pair2 = smt_correlation_type != "Dyad"
bool corr_type_pair3 = smt_correlation_type == "Tetrad"
bool corr_manual_mode = smt_pair_selection == "Manual"
bool corr_manual_pair1_ok = f_has_symbol(smt_manual_pair1) and not f_same_symbol(smt_manual_pair1, syminfo.tickerid)
bool corr_manual_pair2_ok = corr_type_pair2 and f_has_symbol(smt_manual_pair2) and not f_same_symbol(smt_manual_pair2, syminfo.tickerid) and not f_same_symbol(smt_manual_pair2, smt_manual_pair1)
bool corr_manual_pair3_ok = corr_type_pair3 and f_has_symbol(smt_manual_pair3) and not f_same_symbol(smt_manual_pair3, syminfo.tickerid) and not f_same_symbol(smt_manual_pair3, smt_manual_pair1) and not f_same_symbol(smt_manual_pair3, smt_manual_pair2)
if corr_manual_mode
    corr_base_ok := corr_manual_pair1_ok
    corr_has_tertiary := corr_manual_pair2_ok
    corr_has_quaternary := corr_manual_pair3_ok
    csym := corr_manual_pair1_ok ? smt_manual_pair1 : ""
    tsym3 := corr_manual_pair2_ok ? smt_manual_pair2 : ""
    qsym4 := corr_manual_pair3_ok ? smt_manual_pair3 : ""
    corr_inv1 := corr_manual_pair1_ok ? smt_manual_pair1_inverted : false
    corr_inv2 := corr_manual_pair2_ok ? smt_manual_pair2_inverted : false
    corr_inv3 := corr_manual_pair3_ok ? smt_manual_pair3_inverted : false
else
    GXV.AssetConfig corr_cfg = GXV.resolveAssetsByCorrelation(syminfo.ticker, syminfo.tickerid, syminfo.type, syminfo.session, false, smt_correlation_mode, smt_correlation_type)
    corr_base_ok := corr_cfg.detected and f_has_symbol(corr_cfg.secondary) and not f_same_symbol(corr_cfg.secondary, syminfo.tickerid)
    corr_has_tertiary := corr_type_pair2 and corr_base_ok and f_has_symbol(corr_cfg.tertiary) and not f_same_symbol(corr_cfg.tertiary, syminfo.tickerid) and not f_same_symbol(corr_cfg.secondary, corr_cfg.tertiary)
    corr_has_quaternary := corr_type_pair3 and corr_has_tertiary and f_has_symbol(corr_cfg.quaternary) and not f_same_symbol(corr_cfg.quaternary, syminfo.tickerid) and not f_same_symbol(corr_cfg.quaternary, corr_cfg.secondary) and not f_same_symbol(corr_cfg.quaternary, corr_cfg.tertiary)
    csym := corr_base_ok ? corr_cfg.secondary : ""
    tsym3 := corr_has_tertiary ? corr_cfg.tertiary : ""
    qsym4 := corr_has_quaternary ? corr_cfg.quaternary : ""
    corr_inv1 := corr_base_ok ? corr_cfg.invertSecondary : false
    corr_inv2 := corr_has_tertiary ? corr_cfg.invertTertiary : false
    corr_inv3 := corr_has_quaternary ? corr_cfg.invertQuaternary : false
corr_pair1_configured := corr_base_ok and f_has_symbol(csym)
corr_pair2_configured := corr_has_tertiary and f_has_symbol(tsym3)
corr_pair3_configured := corr_has_quaternary and f_has_symbol(qsym4)
string corr_fetch_sym1 = corr_pair1_configured ? csym : INVALID_SECONDARY
string corr_fetch_sym2 = corr_pair2_configured ? tsym3 : INVALID_TERTIARY
string corr_fetch_sym3 = corr_pair3_configured ? qsym4 : INVALID_QUATERNARY
[xh0, xl0, xt0] = request.security(corr_fetch_sym1, tf, [high, low, time], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[yh0, yl0, yt0] = request.security(corr_fetch_sym2, tf, [high, low, time], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[zh0, zl0, zt0] = request.security(corr_fetch_sym3, tf, [high, low, time], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
corr_pair1_ok := corr_pair1_configured and not na(xh0) and not na(xl0) and not na(xt0)
corr_pair2_ok := corr_pair2_configured and not na(yh0) and not na(yl0) and not na(yt0)
corr_pair3_ok := corr_pair3_configured and not na(zh0) and not na(zl0) and not na(zt0)
string smt_pair = corr_pair1_configured ? GXV.getAssetTicker(csym) : ""
string smt_pair2 = corr_pair2_configured ? GXV.getAssetTicker(tsym3) : ""
string smt_pair3 = corr_pair3_configured ? GXV.getAssetTicker(qsym4) : ""
SmtCorrelationDescriptor smt_corr_pair1 = SmtCorrelationDescriptor.new(csym, smt_pair, corr_inv1, corr_pair1_configured, corr_pair1_ok, xh0, xl0, xt0)
SmtCorrelationDescriptor smt_corr_pair2 = SmtCorrelationDescriptor.new(tsym3, smt_pair2, corr_inv2, corr_pair2_configured, corr_pair2_ok, yh0, yl0, yt0)
SmtCorrelationDescriptor smt_corr_pair3 = SmtCorrelationDescriptor.new(qsym4, smt_pair3, corr_inv3, corr_pair3_configured, corr_pair3_ok, zh0, zl0, zt0)

//==============================================================================
// GXV SMT market-state engine
// DATA -> RANGE -> SWEEP -> DIVERGENCE -> EVENT -> INVALIDATION -> PROJECTION
//==============================================================================
const int SMT_STATE_CYCLES = 14
const int SMT_SRC_COUNT = 4
const int SMT_PAIR_COUNT = 3
const int SMT_SRC_MAIN = 0
const int SMT_SRC_PAIR1 = 1
const int SMT_SRC_PAIR2 = 2
const int SMT_SRC_PAIR3 = 3
const int SMT_DIR_BEAR = -1
const int SMT_DIR_BULL = 1
const int SMT_EVENT_LIVE = 1
const int SMT_EVENT_CONFIRMED = 2
const int SMT_EVENT_INVALIDATED = 3
const int SMT_LIVE_SLOTS = SMT_STATE_CYCLES * SMT_PAIR_COUNT * 2
const int SMT_DOMAIN_EVENT_CAP = 600
const int SMT_RENDER_EVENT_CAP = 480

type SmtRangeState
    float currentHigh
    float previousHigh
    float currentLow
    float previousLow
    int currentHighTime
    int previousHighTime
    int currentLowTime
    int previousLowTime
    int currentHighBar
    int previousHighBar
    int currentLowBar
    int previousLowBar
    int cycleKey
    int previousCycleKey
    bool hasCurrentRange
    bool hasPreviousRange

type SmtSweepState
    bool ready
    bool highSwept
    bool lowSwept
    float highPivotA
    float highPivotB
    float lowPivotA
    float lowPivotB
    int highTimeA
    int highTimeB
    int lowTimeA
    int lowTimeB
    int highBarA
    int highBarB
    int lowBarA
    int lowBarB

type SmtEvent
    int id
    int rank
    int pairSlot
    int dir
    int cycleKey
    int previousCycleKey
    float pivotAPrice
    float pivotBPrice
    int pivotATime
    int pivotBTime
    int pivotABar
    int pivotBBar
    int structType
    int state
    bool bodyBlocked
    line lineId
    label labelId
    bool projectA
    bool projectB
    bool bypassed

type SmtLiveSlot
    bool active
    int eventId
    int cycleKey

var array<SmtRangeState> smt_range_states = array.new<SmtRangeState>()
var array<SmtEvent> smt_events = array.new<SmtEvent>()
var array<SmtLiveSlot> smt_live_slots = array.new<SmtLiveSlot>()

f_smt_state_idx(int cycleIdx, int srcIdx) =>
    cycleIdx * SMT_SRC_COUNT + srcIdx

f_smt_live_slot(int rank, int pairSlot, int dir) =>
    (rank - 1) * SMT_PAIR_COUNT * 2 + (pairSlot - 1) * 2 + (dir == SMT_DIR_BULL ? 1 : 0)

f_smt_event_id(int rank, int pairSlot, int dir, int cycleKey) =>
    cycleKey * 100 + f_smt_live_slot(rank, pairSlot, dir)

f_smt_seed_engine() =>
    if array.size(smt_range_states) == 0
        for i = 0 to SMT_STATE_CYCLES * SMT_SRC_COUNT - 1
            array.push(smt_range_states, SmtRangeState.new(na, na, na, na, na, na, na, na, na, na, na, na, na, na, false, false))
    if array.size(smt_live_slots) == 0
        for i = 0 to SMT_LIVE_SLOTS - 1
            array.push(smt_live_slots, SmtLiveSlot.new(false, na, na))
    0

// Auto SMT rank follows the exact active CRT HTF.
// 3H is an internal rank because ICT 30m maps to 3H while the
// original GXV rank list did not expose a 3H switch.
f_smt_auto_rank() =>
    activeTimeframe == "15" ? 1 :
     activeTimeframe == "30" ? 2 :
     activeTimeframe == "60" ? 3 :
     activeTimeframe == "90" ? 4 :
     activeTimeframe == "180" ? 14 :
     activeTimeframe == "240" ? 5 :
     activeTimeframe == "360" ? 6 :
     activeTimeframe == "D" ? 9 :
     activeTimeframe == "W" ? 10 :
     activeTimeframe == "1M" ? 11 : 0

smt_auto_rank = f_smt_auto_rank()

f_smt_rank_enabled(int rank) =>
    smt_auto_mapping ?
         rank == smt_auto_rank :
         rank == 1 ? smt_15m_show :
         rank == 2 ? smt_30m_show :
         rank == 3 ? smt_1h_show :
         rank == 4 ? smt_90m_show :
         rank == 5 ? smt_4h_show :
         rank == 6 ? smt_6h_show :
         rank == 7 ? smt_7h_show :
         rank == 8 ? smt_12h_show :
         rank == 9 ? smt_1d_show :
         rank == 10 ? smt_1w_show :
         rank == 11 ? smt_1m_show :
         rank == 12 ? smt_3m_show :
         rank == 13 ? smt_12m_show : false

f_smt_pair_enabled(int pairSlot) =>
    pairSlot == 1 ? smt_corr_pair1.configured : pairSlot == 2 ? smt_corr_pair2.configured : pairSlot == 3 ? smt_corr_pair3.configured : false

f_smt_rank_shortname(int rank) =>
    rank == 1 ? "15m" : rank == 2 ? "30m" : rank == 3 ? "1H" : rank == 4 ? "90m" : rank == 5 ? "4H" : rank == 6 ? "6H" : rank == 7 ? "7H" : rank == 8 ? "12H" : rank == 9 ? "1D" : rank == 10 ? "1W" : rank == 11 ? "1M" : rank == 12 ? "3M" : rank == 13 ? "12M" : rank == 14 ? "3H" : ""

f_smt_rank_color(int rank) =>
    rank == 1 ? smt_15m_clr : rank == 2 ? smt_30m_clr : rank == 3 ? smt_1h_clr : rank == 4 ? smt_90m_clr : rank == 5 ? smt_4h_clr : rank == 6 ? smt_6h_clr : rank == 7 ? smt_7h_clr : rank == 8 ? smt_12h_clr : rank == 9 ? smt_1d_clr : rank == 10 ? smt_1w_clr : rank == 11 ? smt_1m_clr : rank == 12 ? smt_3m_clr : rank == 13 ? smt_12m_clr : rank == 14 ? smt_4h_clr : color.gray

f_smt_rank_gate_sec(int rank) =>
    rank == 1 ? SMT_GATE_15M : rank == 2 ? SMT_GATE_30M : rank == 3 ? SMT_GATE_1H : rank == 4 ? SMT_GATE_90M : rank == 5 ? SMT_GATE_4H : rank == 6 ? SMT_GATE_6H : rank == 7 ? SMT_GATE_7H : rank == 8 ? SMT_GATE_12H : rank == 9 ? SMT_GATE_1D : rank == 10 ? SMT_GATE_1W : rank == 11 ? SMT_GATE_1M : rank == 12 ? SMT_GATE_3M : rank == 13 ? SMT_GATE_12M : SMT_GATE_3H

f_smt_pair_name_for_slot(int pairSlot) =>
    pairSlot == 1 ? smt_corr_pair1.displayName : pairSlot == 2 ? smt_corr_pair2.displayName : pairSlot == 3 ? smt_corr_pair3.displayName : ""

f_smt_label_text(string shortname, string pairName) =>
    smt_label_style == "Asset Only" ? "SMT " + pairName : smt_label_style == "TF Only" ? shortname + " SMT" : shortname + " SMT " + pairName

f_smt_default_label_text(int rank, int pairSlot) =>
    f_smt_label_text(f_smt_rank_shortname(rank), f_smt_pair_name_for_slot(pairSlot))

f_smt_bypass_label_text(int rank, int pairSlot) =>
    smt_label_style == "Asset Only" ? f_smt_pair_name_for_slot(pairSlot) : f_smt_rank_shortname(rank)

f_smt_labels_for_rank(int rank) =>
    bool dynamicExcluded = rank == 12 or rank == 13
    bool hideAtOrAboveGate = smt_dynamic_labels and not dynamicExcluded and tf_sec >= f_smt_rank_gate_sec(rank)
    smt_labels_show and not hideAtOrAboveGate

f_smt_event_mid_y(float y1, float y2) =>
    math.round_to_mintick((y1 + y2) * 0.5)

f_smt_event_label_time(int x1, int x2, int b1, int b2) =>
    int labelBar = int(math.floor((b1 + b2) * 0.5))
    int labelOffset = bar_index - labelBar
    bool canUseMidBarTime = not na(labelBar) and labelOffset >= 0 and labelOffset <= 5000
    canUseMidBarTime ? time[labelOffset] : int(math.round(x1 + (x2 - x1) * 0.5))

f_smt_structure_type(bool isBull, float y1, float y2) =>
    isBull ? (y2 > y1 ? 1 : y2 < y1 ? 2 : 0) : (y2 > y1 ? 3 : y2 < y1 ? 4 : 0)

f_smt_struct_required_for_cleanup(int rank) =>
    rank == 11 or rank == 12 or rank == 13

f_smt_cleanup_struct_ok(int dominatedRank, int dominatedStruct, int dominantStruct) =>
    not f_smt_struct_required_for_cleanup(dominatedRank) or (dominatedStruct != 0 and dominatedStruct == dominantStruct)

f_smt_body_filter_applies(int rank) =>
    rank != 13

f_smt_body_intersects(int bx1, int bx2, float y1, float y2) =>
    bool hit = false
    int span = bx2 - bx1
    if span > 3
        int fromX = math.max(bx1 + 2, bar_index - 4999)
        int toX = math.min(bx2 - 2, bar_index)
        if fromX <= toX
            for x = fromX to toX
                int barsAgo = bar_index - x
                float linePrice = y1 + (y2 - y1) * (x - bx1) / span
                float bodyLow = math.min(open[barsAgo], close[barsAgo])
                float bodyHigh = math.max(open[barsAgo], close[barsAgo])
                if bodyLow <= linePrice and linePrice <= bodyHigh
                    hit := true
                    break
    hit

// Equality is not a liquidity take; strict extrema retain first-touch identity.
f_smt_high_swept(float currentValue, float previousValue) =>
    not na(currentValue) and not na(previousValue) and currentValue > previousValue

f_smt_low_swept(float currentValue, float previousValue) =>
    not na(currentValue) and not na(previousValue) and currentValue < previousValue

f_smt_update_state(int cycleIdx, int srcIdx, bool engineEnabled, int rangeKey, float srcHigh, float srcLow, int srcTime) =>
    if engineEnabled and not na(rangeKey)
        int idx = f_smt_state_idx(cycleIdx, srcIdx)
        SmtRangeState st = array.get(smt_range_states, idx)
        bool dataReady = not na(srcHigh) and not na(srcLow) and not na(srcTime)
        if na(st.cycleKey)
            st.cycleKey := rangeKey
            st.previousCycleKey := na
            st.hasCurrentRange := false
            st.hasPreviousRange := false
        else if rangeKey != st.cycleKey
            st.previousHigh := st.currentHigh
            st.previousLow := st.currentLow
            st.previousHighTime := st.currentHighTime
            st.previousLowTime := st.currentLowTime
            st.previousHighBar := st.currentHighBar
            st.previousLowBar := st.currentLowBar
            st.previousCycleKey := st.cycleKey
            st.hasPreviousRange := st.hasCurrentRange
            st.currentHigh := na
            st.currentLow := na
            st.currentHighTime := na
            st.currentLowTime := na
            st.currentHighBar := na
            st.currentLowBar := na
            st.hasCurrentRange := false
            st.cycleKey := rangeKey
        if dataReady and st.cycleKey == rangeKey
            if na(st.currentHigh) or srcHigh > st.currentHigh
                st.currentHigh := srcHigh
                st.currentHighTime := srcTime
                st.currentHighBar := bar_index
            if na(st.currentLow) or srcLow < st.currentLow
                st.currentLow := srcLow
                st.currentLowTime := srcTime
                st.currentLowBar := bar_index
            st.hasCurrentRange := true
        array.set(smt_range_states, idx, st)
    0

f_smt_get_state(int cycleIdx, int srcIdx) =>
    array.get(smt_range_states, f_smt_state_idx(cycleIdx, srcIdx))

// Inverse pairs are normalized once into main-domain high/low liquidity actions.
f_smt_build_sweeps(SmtRangeState st, bool inverse) =>
    bool ready = st.hasCurrentRange and st.hasPreviousRange
    float highA = inverse ? st.previousLow : st.previousHigh
    float highB = inverse ? st.currentLow : st.currentHigh
    float lowA = inverse ? st.previousHigh : st.previousLow
    float lowB = inverse ? st.currentHigh : st.currentLow
    int highTimeA = inverse ? st.previousLowTime : st.previousHighTime
    int highTimeB = inverse ? st.currentLowTime : st.currentHighTime
    int lowTimeA = inverse ? st.previousHighTime : st.previousLowTime
    int lowTimeB = inverse ? st.currentHighTime : st.currentLowTime
    int highBarA = inverse ? st.previousLowBar : st.previousHighBar
    int highBarB = inverse ? st.currentLowBar : st.currentHighBar
    int lowBarA = inverse ? st.previousHighBar : st.previousLowBar
    int lowBarB = inverse ? st.currentHighBar : st.currentLowBar
    bool highSweep = ready and (inverse ? f_smt_low_swept(highB, highA) : f_smt_high_swept(highB, highA))
    bool lowSweep = ready and (inverse ? f_smt_high_swept(lowB, lowA) : f_smt_low_swept(lowB, lowA))
    SmtSweepState.new(ready, highSweep, lowSweep, highA, highB, lowA, lowB, highTimeA, highTimeB, lowTimeA, lowTimeB, highBarA, highBarB, lowBarA, lowBarB)

f_smt_xor(bool first, bool second) =>
    (first and not second) or (not first and second)

// Pure divergence truth: exactly one synchronized market sweeps corresponding liquidity.
f_smt_resolve_pair_state(SmtSweepState mainSweep, SmtSweepState pairSweep) =>
    bool ready = mainSweep.ready and pairSweep.ready
    bool bearValid = ready and f_smt_xor(mainSweep.highSwept, pairSweep.highSwept)
    bool bullValid = ready and f_smt_xor(mainSweep.lowSwept, pairSweep.lowSwept)
    [bearValid, bullValid]
//==============================================================================
// Session and time projection policy
//==============================================================================
f_smt_time_to_minutes(string t) =>
    array<string> parts = str.split(t, ":")
    int h = array.size(parts) > 0 ? int(str.tonumber(array.get(parts, 0))) : 0
    int m = array.size(parts) > 1 ? int(str.tonumber(array.get(parts, 1))) : 0
    h * 60 + m

f_smt_minutes_in_window(int tMin, int startMin, int endMin) =>
    startMin <= endMin ? (tMin >= startMin and tMin <= endMin) : (tMin >= startMin or tMin <= endMin)

var int smt_session_1_start_min = f_smt_time_to_minutes(smt_session_1_start)
var int smt_session_1_end_min = f_smt_time_to_minutes(smt_session_1_end)
var int smt_session_2_start_min = f_smt_time_to_minutes(smt_session_2_start)
var int smt_session_2_end_min = f_smt_time_to_minutes(smt_session_2_end)
var int smt_session_3_start_min = f_smt_time_to_minutes(smt_session_3_start)
var int smt_session_3_end_min = f_smt_time_to_minutes(smt_session_3_end)
var int smt_session_4_start_min = f_smt_time_to_minutes(smt_session_4_start)
var int smt_session_4_end_min = f_smt_time_to_minutes(smt_session_4_end)

smt_session_filter_effective = smt_session_filter_on and not na(tf_sec) and tf_sec <= TF_SEC_30
smt_current_day_filter_effective = smt_render_current_day_only and not na(tf_sec) and tf_sec < TF_SEC_240
smt_render_day_ref = last_bar_time
smt_render_day_start = timestamp(oracle_tz, year(smt_render_day_ref, oracle_tz), month(smt_render_day_ref, oracle_tz), dayofmonth(smt_render_day_ref, oracle_tz), 0, 0)
smt_render_day_end = timestamp(oracle_tz, year(smt_render_day_ref, oracle_tz), month(smt_render_day_ref, oracle_tz), dayofmonth(smt_render_day_ref, oracle_tz) + 1, 0, 0)

smt_auto_reference_time = last_bar_time
smt_auto_current_minutes = smt_session_filter_effective and smt_auto_session_filter ? hour(smt_auto_reference_time, "America/New_York") * 60 + minute(smt_auto_reference_time, "America/New_York") : na
smt_auto_session_1_active = smt_session_filter_effective and smt_auto_session_filter and f_smt_minutes_in_window(smt_auto_current_minutes, smt_session_1_start_min, smt_session_1_end_min)
smt_auto_session_2_active = smt_session_filter_effective and smt_auto_session_filter and not smt_auto_session_1_active and f_smt_minutes_in_window(smt_auto_current_minutes, smt_session_2_start_min, smt_session_2_end_min)
smt_auto_session_3_active = smt_session_filter_effective and smt_auto_session_filter and not smt_auto_session_1_active and not smt_auto_session_2_active and f_smt_minutes_in_window(smt_auto_current_minutes, smt_session_3_start_min, smt_session_3_end_min)
smt_auto_session_4_active = smt_session_filter_effective and smt_auto_session_filter and not smt_auto_session_1_active and not smt_auto_session_2_active and not smt_auto_session_3_active and f_smt_minutes_in_window(smt_auto_current_minutes, smt_session_4_start_min, smt_session_4_end_min)

f_smt_session_render_ok(int pivotBTime) =>
    bool ok = true
    if smt_session_filter_effective
        ok := false
        if not na(pivotBTime)
            int pivotMinutes = hour(pivotBTime, "America/New_York") * 60 + minute(pivotBTime, "America/New_York")
            if smt_auto_session_filter
                ok := smt_auto_session_1_active ? f_smt_minutes_in_window(pivotMinutes, smt_session_1_start_min, smt_session_1_end_min) : smt_auto_session_2_active ? f_smt_minutes_in_window(pivotMinutes, smt_session_2_start_min, smt_session_2_end_min) : smt_auto_session_3_active ? f_smt_minutes_in_window(pivotMinutes, smt_session_3_start_min, smt_session_3_end_min) : smt_auto_session_4_active ? f_smt_minutes_in_window(pivotMinutes, smt_session_4_start_min, smt_session_4_end_min) : false
            else
                bool inSession1 = smt_session_1_on and f_smt_minutes_in_window(pivotMinutes, smt_session_1_start_min, smt_session_1_end_min)
                bool inSession2 = smt_session_2_on and f_smt_minutes_in_window(pivotMinutes, smt_session_2_start_min, smt_session_2_end_min)
                bool inSession3 = smt_session_3_on and f_smt_minutes_in_window(pivotMinutes, smt_session_3_start_min, smt_session_3_end_min)
                bool inSession4 = smt_session_4_on and f_smt_minutes_in_window(pivotMinutes, smt_session_4_start_min, smt_session_4_end_min)
                ok := inSession1 or inSession2 or inSession3 or inSession4
    ok

f_smt_current_day_render_ok(int pivotBTime) =>
    not smt_current_day_filter_effective or (not na(pivotBTime) and pivotBTime >= smt_render_day_start and pivotBTime < smt_render_day_end)

f_smt_render_time_ok(int pivotBTime) =>
    f_smt_session_render_ok(pivotBTime) and f_smt_current_day_render_ok(pivotBTime)

f_smt_nearby_render_ok(int pivotBBar) =>
    not smt_render_nearby_only or (not na(pivotBBar) and pivotBBar >= last_bar_index - smt_nearby_bars)

//==============================================================================
// Domain event lifecycle
//==============================================================================
f_smt_find_event_by_id(int eventId) =>
    int idx = -1
    int i = 0
    while i < array.size(smt_events) and idx < 0
        if array.get(smt_events, i).id == eventId
            idx := i
        i += 1
    idx

f_smt_drop_render_at(int idx) =>
    if idx >= 0 and idx < array.size(smt_events)
        SmtEvent event = array.get(smt_events, idx)
        if not na(event.labelId)
            label.delete(event.labelId)
            event.labelId := na
        if not na(event.lineId)
            line.delete(event.lineId)
            event.lineId := na
        array.set(smt_events, idx, event)
    0

f_smt_delete_event_at(int idx) =>
    bool deleted = false
    if idx >= 0 and idx < array.size(smt_events)
        f_smt_drop_render_at(idx)
        array.remove(smt_events, idx)
        deleted := true
    deleted

f_smt_release_live_slot(int slot) =>
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        live.active := false
        live.eventId := na
        live.cycleKey := na
        array.set(smt_live_slots, slot, live)
    0

f_smt_remove_live_slot(int slot) =>
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        if live.active and not na(live.eventId)
            int eventIdx = f_smt_find_event_by_id(live.eventId)
            if eventIdx >= 0
                f_smt_delete_event_at(eventIdx)
        f_smt_release_live_slot(slot)
    0

f_smt_finalize_live_slot(int slot, int currentCycle) =>
    bool finalized = false
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        if live.active and not na(currentCycle) and not na(live.cycleKey) and currentCycle != live.cycleKey
            int eventIdx = f_smt_find_event_by_id(live.eventId)
            if eventIdx >= 0
                SmtEvent event = array.get(smt_events, eventIdx)
                if event.state == SMT_EVENT_LIVE
                    event.state := SMT_EVENT_CONFIRMED
                    event.projectA := false
                    event.projectB := false
                    event.bypassed := false
                    array.set(smt_events, eventIdx, event)
                    finalized := true
            f_smt_release_live_slot(slot)
    finalized

f_smt_sync_live_candidate(bool valid, int cycleKey, int previousCycleKey, int rank, int pairSlot, int dir, float y1, float y2, int t1, int t2, int b1, int b2) =>
    int slot = f_smt_live_slot(rank, pairSlot, dir)
    SmtLiveSlot live = array.get(smt_live_slots, slot)
    bool fieldsReady = not na(cycleKey) and not na(previousCycleKey) and not na(y1) and not na(y2) and not na(t1) and not na(t2) and not na(b1) and not na(b2)
    if live.active and (not valid or not fieldsReady or live.cycleKey != cycleKey)
        f_smt_remove_live_slot(slot)
        live := array.get(smt_live_slots, slot)
    if valid and fieldsReady
        int eventId = f_smt_event_id(rank, pairSlot, dir, cycleKey)
        int eventIdx = live.active ? f_smt_find_event_by_id(live.eventId) : -1
        if eventIdx < 0
            bool bodyBlocked = f_smt_body_filter_applies(rank) and f_smt_body_intersects(b1, b2, y1, y2)
            SmtEvent event = SmtEvent.new(eventId, rank, pairSlot, dir, cycleKey, previousCycleKey, y1, y2, t1, t2, b1, b2, f_smt_structure_type(dir == SMT_DIR_BULL, y1, y2), SMT_EVENT_LIVE, bodyBlocked, na, na, false, false, false)
            array.unshift(smt_events, event)
            live.active := true
            live.eventId := eventId
            live.cycleKey := cycleKey
            array.set(smt_live_slots, slot, live)
        else
            SmtEvent event = array.get(smt_events, eventIdx)
            bool pivotChanged = event.pivotAPrice != y1 or event.pivotBPrice != y2 or event.pivotATime != t1 or event.pivotBTime != t2 or event.pivotABar != b1 or event.pivotBBar != b2
            if pivotChanged
                event.pivotAPrice := y1
                event.pivotBPrice := y2
                event.pivotATime := t1
                event.pivotBTime := t2
                event.pivotABar := b1
                event.pivotBBar := b2
                event.structType := f_smt_structure_type(dir == SMT_DIR_BULL, y1, y2)
                event.bodyBlocked := f_smt_body_filter_applies(rank) and f_smt_body_intersects(b1, b2, y1, y2)
                array.set(smt_events, eventIdx, event)
    0

f_smt_event_invalidated(SmtEvent event) =>
    event.state == SMT_EVENT_CONFIRMED and bar_index > event.pivotBBar and ((event.dir == SMT_DIR_BEAR and high >= event.pivotBPrice) or (event.dir == SMT_DIR_BULL and low <= event.pivotBPrice))

f_smt_mark_historical_invalidations() =>
    int n = array.size(smt_events)
    if n > 0
        for i = n - 1 to 0
            SmtEvent event = array.get(smt_events, i)
            if f_smt_event_invalidated(event)
                event.state := SMT_EVENT_INVALIDATED
                event.projectA := false
                event.projectB := false
                array.set(smt_events, i, event)
    0

f_smt_gc_events() =>
    int i = array.size(smt_events) - 1
    while i >= 0
        if array.get(smt_events, i).state == SMT_EVENT_INVALIDATED
            f_smt_delete_event_at(i)
        i -= 1
    while array.size(smt_events) > SMT_DOMAIN_EVENT_CAP
        int removeIdx = array.size(smt_events) - 1
        while removeIdx >= 0 and array.get(smt_events, removeIdx).state == SMT_EVENT_LIVE
            removeIdx -= 1
        if removeIdx >= 0
            f_smt_delete_event_at(removeIdx)
        else
            break
    0
//==============================================================================
// Deterministic render projection and arbitration
//==============================================================================
f_smt_event_base_render_ok(SmtEvent event) =>
    bool activeState = event.state == SMT_EVENT_LIVE or event.state == SMT_EVENT_CONFIRMED
    activeState and f_smt_rank_enabled(event.rank) and f_smt_pair_enabled(event.pairSlot) and f_smt_monthly_tf_render_ok(event.rank) and f_smt_nearby_render_ok(event.pivotBBar) and f_smt_render_time_ok(event.pivotBTime) and not event.bodyBlocked

f_smt_hard_winner(SmtEvent dominant, SmtEvent candidate) =>
    dominant.rank > candidate.rank or (dominant.rank == candidate.rank and dominant.pairSlot < candidate.pairSlot) or (dominant.rank == candidate.rank and dominant.pairSlot == candidate.pairSlot and dominant.id < candidate.id)

f_smt_hard_loses(int idx) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectA and candidate.dir != 0 and not na(candidate.pivotATime) and not na(candidate.pivotBTime) and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent other = array.get(smt_events, i)
                bool sameEvent = other.projectA and other.dir == candidate.dir and other.pivotATime == candidate.pivotATime and other.pivotBTime == candidate.pivotBTime
                loses := sameEvent and f_smt_hard_winner(other, candidate)
    loses

f_smt_inside_dominates(SmtEvent keeper, SmtEvent candidate) =>
    int keepLeft = math.min(keeper.pivotABar, keeper.pivotBBar)
    int keepRight = math.max(keeper.pivotABar, keeper.pivotBBar)
    int candidateLeft = math.min(candidate.pivotABar, candidate.pivotBBar)
    int candidateRight = math.max(candidate.pivotABar, candidate.pivotBBar)
    int keepSpan = keepRight - keepLeft
    int candidateSpan = candidateRight - candidateLeft
    bool directionOk = keeper.dir != 0 and keeper.dir == candidate.dir
    bool structureOk = f_smt_cleanup_struct_ok(candidate.rank, candidate.structType, keeper.structType)
    bool priorityOk = keeper.rank > candidate.rank or (keeper.rank == candidate.rank and keepSpan > candidateSpan)
    candidateLeft >= keepLeft + 1 and candidateRight <= keepRight - 1 and keepSpan > candidateSpan and candidateSpan > 0 and keepSpan >= 3 and directionOk and structureOk and priorityOk

f_smt_inside_loses(int idx) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectB and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent keeper = array.get(smt_events, i)
                loses := keeper.projectB and f_smt_inside_dominates(keeper, candidate)
    loses

f_smt_pivot_winner(SmtEvent dominant, SmtEvent candidate) =>
    dominant.rank > candidate.rank or (dominant.rank == candidate.rank and dominant.id < candidate.id)

f_smt_pivot_loses(int idx, bool checkPivotA) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectA and candidate.dir != 0 and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent other = array.get(smt_events, i)
                bool samePivot = checkPivotA ? other.pivotATime == candidate.pivotATime : other.pivotBTime == candidate.pivotBTime
                bool directionOk = other.dir == candidate.dir
                bool structureOk = f_smt_cleanup_struct_ok(candidate.rank, candidate.structType, other.structType)
                loses := other.projectA and samePivot and directionOk and structureOk and f_smt_pivot_winner(other, candidate)
    loses

f_smt_prepare_projection() =>
    int n = array.size(smt_events)
    if n > 0
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool baseEligible = f_smt_event_base_render_ok(event)
            event.projectA := baseEligible
            event.projectB := baseEligible
            event.bypassed := false
            array.set(smt_events, i, event)

        // Exact A-B arbitration is independent from optional cleanup modes.
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            event.projectB := event.projectA and not f_smt_hard_loses(i)
            array.set(smt_events, i, event)

        bool insideBypassMode = smt_cleanup_mode == "Bypass Inside Range"
        bool evaluateInside = smt_cleanup_inside or insideBypassMode
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool losesInside = evaluateInside and event.projectB and f_smt_inside_loses(i)
            event.projectA := event.projectB and not (smt_cleanup_inside and losesInside)
            event.bypassed := smt_aesthetic_bypass and insideBypassMode and losesInside
            array.set(smt_events, i, event)

        bool pivotABypassMode = smt_cleanup_mode == "Bypass Pivot A"
        bool pivotBBypassMode = smt_cleanup_mode == "Bypass Pivot B"
        bool evaluatePivotA = smt_cleanup_pivot_a or pivotABypassMode
        bool evaluatePivotB = smt_cleanup_pivot_b or pivotBBypassMode
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool losesPivotA = evaluatePivotA and event.projectA and f_smt_pivot_loses(i, true)
            bool losesPivotB = evaluatePivotB and event.projectA and f_smt_pivot_loses(i, false)
            bool removed = (smt_cleanup_pivot_a and losesPivotA) or (smt_cleanup_pivot_b and losesPivotB)
            event.projectB := event.projectA and not removed
            bool pivotBypassed = (pivotABypassMode and losesPivotA) or (pivotBBypassMode and losesPivotB)
            event.bypassed := event.bypassed or (smt_aesthetic_bypass and pivotBypassed)
            array.set(smt_events, i, event)
    0

f_smt_sync_render_at(int idx, bool shouldRender) =>
    if idx >= 0 and idx < array.size(smt_events)
        SmtEvent event = array.get(smt_events, idx)
        if shouldRender
            color eventColor = event.bypassed ? color.new(f_smt_rank_color(event.rank), 65) : f_smt_rank_color(event.rank)
            if na(event.lineId)
                event.lineId := line.new(x1=event.pivotATime, y1=event.pivotAPrice, x2=event.pivotBTime, y2=event.pivotBPrice, xloc=xloc.bar_time, color=eventColor, width=1, style=smt_line_style)
            else
                line.set_xy1(event.lineId, event.pivotATime, event.pivotAPrice)
                line.set_xy2(event.lineId, event.pivotBTime, event.pivotBPrice)
                line.set_color(event.lineId, eventColor)
                line.set_style(event.lineId, smt_line_style)
            bool labelsOn = f_smt_labels_for_rank(event.rank)
            if labelsOn
                int labelTime = f_smt_event_label_time(event.pivotATime, event.pivotBTime, event.pivotABar, event.pivotBBar)
                string defaultText = f_smt_default_label_text(event.rank, event.pairSlot)
                string displayText = event.bypassed ? (smt_bypass_labels_show ? f_smt_bypass_label_text(event.rank, event.pairSlot) : "") : defaultText
                color textColor = event.bypassed ? (smt_bypass_labels_show ? color.new(smt_txt_all, 50) : color.new(smt_txt_all, 100)) : smt_txt_all
                if na(event.labelId)
                    event.labelId := label.new(x=labelTime, y=f_smt_event_mid_y(event.pivotAPrice, event.pivotBPrice), text=displayText, xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.white, 100), style=event.dir == SMT_DIR_BULL ? label.style_label_up : label.style_label_down, textcolor=textColor, size=smt_label_size, tooltip=defaultText)
                else
                    label.set_x(event.labelId, labelTime)
                    label.set_y(event.labelId, f_smt_event_mid_y(event.pivotAPrice, event.pivotBPrice))
                    label.set_text(event.labelId, displayText)
                    label.set_textcolor(event.labelId, textColor)
                    label.set_size(event.labelId, smt_label_size)
            else if not na(event.labelId)
                label.delete(event.labelId)
                event.labelId := na
        else
            if not na(event.labelId)
                label.delete(event.labelId)
                event.labelId := na
            if not na(event.lineId)
                line.delete(event.lineId)
                event.lineId := na
        array.set(smt_events, idx, event)
    0

f_smt_project_events() =>
    if barstate.islast
        f_smt_prepare_projection()
        array<int> bucketCounts = array.new_int(SMT_LIVE_SLOTS, 0)
        int rendered = 0
        int n = array.size(smt_events)
        if n > 0
            // Global object pressure is resolved by rank first, then recency.
            for rankCursor = SMT_STATE_CYCLES to 1
                for i = 0 to n - 1
                    SmtEvent event = array.get(smt_events, i)
                    if event.rank == rankCursor
                        bool shouldRender = event.projectB
                        if shouldRender and event.state == SMT_EVENT_CONFIRMED
                            int bucket = f_smt_live_slot(event.rank, event.pairSlot, event.dir)
                            int bucketCount = array.get(bucketCounts, bucket)
                            shouldRender := bucketCount < smt_history_limit
                            if shouldRender
                                array.set(bucketCounts, bucket, bucketCount + 1)
                        shouldRender := shouldRender and rendered < SMT_RENDER_EVENT_CAP
                        if shouldRender
                            rendered += 1
                        event.projectA := shouldRender
                        array.set(smt_events, i, event)
            for i = 0 to n - 1
                f_smt_sync_render_at(i, array.get(smt_events, i).projectA)
    0
//==============================================================================
// Family runtime
//==============================================================================
f_smt_run_pair(SmtRangeState mainState, SmtRangeState pairState, bool engineEnabled, SmtCorrelationDescriptor pair, int rank, int pairSlot) =>
    bool bearFinalized = false
    bool bullFinalized = false
    if not na(mainState.cycleKey)
        int bearSlot = f_smt_live_slot(rank, pairSlot, SMT_DIR_BEAR)
        int bullSlot = f_smt_live_slot(rank, pairSlot, SMT_DIR_BULL)
        // Finalization belongs to the main range transition and never to a line.
        bearFinalized := f_smt_finalize_live_slot(bearSlot, mainState.cycleKey)
        bullFinalized := f_smt_finalize_live_slot(bullSlot, mainState.cycleKey)
        bool cycleAligned = mainState.cycleKey == pairState.cycleKey and not na(mainState.previousCycleKey) and mainState.previousCycleKey == pairState.previousCycleKey
        bool rangesReady = mainState.hasCurrentRange and mainState.hasPreviousRange and pairState.hasCurrentRange and pairState.hasPreviousRange
        bool canResolve = engineEnabled and pair.configured and pair.dataReady and cycleAligned and rangesReady
        if canResolve
            SmtSweepState mainSweep = f_smt_build_sweeps(mainState, false)
            SmtSweepState pairSweep = f_smt_build_sweeps(pairState, pair.inverse)
            [bearValid, bullValid] = f_smt_resolve_pair_state(mainSweep, pairSweep)
            f_smt_sync_live_candidate(bearValid, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BEAR, mainSweep.highPivotA, mainSweep.highPivotB, mainSweep.highTimeA, mainSweep.highTimeB, mainSweep.highBarA, mainSweep.highBarB)
            f_smt_sync_live_candidate(bullValid, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BULL, mainSweep.lowPivotA, mainSweep.lowPivotB, mainSweep.lowTimeA, mainSweep.lowTimeB, mainSweep.lowBarA, mainSweep.lowBarB)
        else
            f_smt_sync_live_candidate(false, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BEAR, na, na, na, na, na, na)
            f_smt_sync_live_candidate(false, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BULL, na, na, na, na, na, na)
    [bearFinalized, bullFinalized]

f_run_smt_cycle(int cycleIdx, bool engineEnabled, int rangeKey, int rank) =>
    // Calculation gates own engine cost. Show toggles own only final projection.
    f_smt_update_state(cycleIdx, SMT_SRC_MAIN, engineEnabled, rangeKey, high, low, time)
    f_smt_update_state(cycleIdx, SMT_SRC_PAIR1, engineEnabled and smt_corr_pair1.configured, rangeKey, smt_corr_pair1.sourceHigh, smt_corr_pair1.sourceLow, smt_corr_pair1.sourceTime)
    f_smt_update_state(cycleIdx, SMT_SRC_PAIR2, engineEnabled and smt_corr_pair2.configured, rangeKey, smt_corr_pair2.sourceHigh, smt_corr_pair2.sourceLow, smt_corr_pair2.sourceTime)
    f_smt_update_state(cycleIdx, SMT_SRC_PAIR3, engineEnabled and smt_corr_pair3.configured, rangeKey, smt_corr_pair3.sourceHigh, smt_corr_pair3.sourceLow, smt_corr_pair3.sourceTime)
    SmtRangeState mainState = f_smt_get_state(cycleIdx, SMT_SRC_MAIN)
    SmtRangeState pair1State = f_smt_get_state(cycleIdx, SMT_SRC_PAIR1)
    SmtRangeState pair2State = f_smt_get_state(cycleIdx, SMT_SRC_PAIR2)
    SmtRangeState pair3State = f_smt_get_state(cycleIdx, SMT_SRC_PAIR3)
    [b1, u1] = f_smt_run_pair(mainState, pair1State, engineEnabled, smt_corr_pair1, rank, 1)
    [b2, u2] = f_smt_run_pair(mainState, pair2State, engineEnabled, smt_corr_pair2, rank, 2)
    [b3, u3] = f_smt_run_pair(mainState, pair3State, engineEnabled, smt_corr_pair3, rank, 3)
    [b1 or b2 or b3, u1 or u2 or u3]

//==============================================================================
// GXV SMT execution
//==============================================================================
f_smt_seed_engine()

// Auto mapping can intentionally calculate the mapped HTF from the
// current chart timeframe (e.g. 4H chart -> 1W, 1D chart -> 1M).
f_smt_engine_enabled(int rank, bool legacyGate) =>
    smt_auto_mapping and rank == smt_auto_rank ? true : legacyGate

[smt_b13, smt_u13] = f_run_smt_cycle(12, f_smt_engine_enabled(13, tf_ok_12m), val_sesY, 13)
[smt_b12, smt_u12] = f_run_smt_cycle(11, f_smt_engine_enabled(12, tf_ok_3m), val_sesQ, 12)
[smt_b11, smt_u11] = f_run_smt_cycle(10, f_smt_engine_enabled(11, tf_ok_1m), val_sesMT, 11)
[smt_b10, smt_u10] = f_run_smt_cycle(9, f_smt_engine_enabled(10, tf_ok_1w), val_sesM, 10)
[smt_b9, smt_u9] = f_run_smt_cycle(8, f_smt_engine_enabled(9, tf_ok_1d), val_sesW, 9)
[smt_b8, smt_u8] = f_run_smt_cycle(7, f_smt_engine_enabled(8, tf_ok_12h), val_ses720, 8)
[smt_b7, smt_u7] = f_run_smt_cycle(6, f_smt_engine_enabled(7, tf_ok_7h), val_ses420, 7)
[smt_b6, smt_u6] = f_run_smt_cycle(5, f_smt_engine_enabled(6, tf_ok_6h), val_sesD, 6)
[smt_b5, smt_u5] = f_run_smt_cycle(4, f_smt_engine_enabled(5, tf_ok_4h), val_ses240, 5)
[smt_b4, smt_u4] = f_run_smt_cycle(3, f_smt_engine_enabled(4, tf_ok_90m), val_ses90, 4)
[smt_b3, smt_u3] = f_run_smt_cycle(2, f_smt_engine_enabled(3, tf_ok_1h), val_ses60, 3)
[smt_b2, smt_u2] = f_run_smt_cycle(1, f_smt_engine_enabled(2, tf_ok_30m), val_ses30, 2)
[smt_b1, smt_u1] = f_run_smt_cycle(0, f_smt_engine_enabled(1, tf_ok_15m), val_ses15, 1)
// Internal 3H SMT family for exact ICT 30m -> 3H auto mapping.
[smt_b14, smt_u14] = f_run_smt_cycle(13, f_smt_engine_enabled(14, tf_ok_3h), val_ses180, 14)

// Check newly confirmed events on the rollover bar itself.
f_smt_mark_historical_invalidations()
f_smt_gc_events()
f_smt_project_events()

//================================================================
//  TRUE OPENS
//  Source of truth: "Daye's True Opens [Quarterly Theory]" — open-source,
//  author-confirmed. This replaces the previous TRUEOPENS.pine-based
//  engine entirely. Ported behaviorally as-is: ONE current line+label per
//  True Open type, replaced at each new cycle's open, extended live to the
//  current bar. Every identifier is namespaced crtTo_ solely to avoid
//  collisions with the CRT/SMT/CISD engines above. Nothing in this
//  block touches the CRT separator engine or creates a second hierarchy.
//================================================================
string g_trueopens = "True Opens"

bool crtTo_showSessions = input.bool(false, "True Session Opens", group=g_trueopens,
     tooltip="Shows the most recent True Open for each of the 4 sessions (Asia, London, NY AM, NY PM).")
bool crtTo_showDay   = input.bool(true, "True Day Open  (00:00 NY)",        group=g_trueopens)
bool crtTo_showWeek  = input.bool(true, "True Week Open (Mon 18:00 NY)",    group=g_trueopens)
bool crtTo_showMonth = input.bool(true, "True Month Open (2nd Mon 18:00)",  group=g_trueopens)
bool crtTo_showYear  = input.bool(true, "True Year Open (Apr 1, 00:00 NY)", group=g_trueopens)

color crtTo_sessionColor = input.color(color.black, "Session Color", group=g_trueopens)
color crtTo_dayColor     = input.color(color.black, "Day Color",     group=g_trueopens)
color crtTo_weekColor    = input.color(color.black, "Week Color",    group=g_trueopens)
color crtTo_monthColor   = input.color(color.black, "Month Color",   group=g_trueopens)
color crtTo_yearColor    = input.color(color.black, "Year Color",    group=g_trueopens)

int    crtTo_lineWidth   = input.int(1, "Line Width", minval=1, maxval=5, group=g_trueopens)
string crtTo_lineStyleIn = input.string("solid", "Line Style", options=["solid", "dashed", "dotted"], group=g_trueopens)
bool   crtTo_showLabels  = input.bool(true, "Show Labels", group=g_trueopens)
int    crtTo_labelGap    = input.int(2, "Label Gap (bars right of line)", minval=0, group=g_trueopens)

crtTo_lineStyle = crtTo_lineStyleIn == "dashed" ? line.style_dashed : crtTo_lineStyleIn == "dotted" ? line.style_dotted : line.style_solid

// ---- Time helper. tz is fixed to America/New_York, exactly as the
// source script defines it. ----
crtTo_tz = "America/New_York"

crtTo_isStart(string _sessStr) =>
    int _t = time(timeframe.period, _sessStr, crtTo_tz)
    not na(_t) and na(_t[1])

// ---- Open triggers (identical session/day/week/month/year rules as the
// source script, including its independent isTrueWk vs mondayAt18 calc). ----
bool crtTo_isAsia     = crtTo_isStart("1930-1931:1234567")
bool crtTo_isLondon   = crtTo_isStart("0130-0131:1234567")
bool crtTo_isNYAM     = crtTo_isStart("0730-0731:1234567")
bool crtTo_isNYPM     = crtTo_isStart("1330-1331:1234567")
bool crtTo_isTrueDay  = crtTo_isStart("0000-0001:1234567")
bool crtTo_isTrueWk   = crtTo_isStart("1800-1801:2")
bool crtTo_mondayAt18 = crtTo_isStart("1800-1801:2")

int crtTo_nyMonth = month(time, crtTo_tz)

var int crtTo_mondayCount = 0
if crtTo_nyMonth != crtTo_nyMonth[1]
    crtTo_mondayCount := 0
if crtTo_mondayAt18
    crtTo_mondayCount += 1
bool crtTo_isTrueMo = crtTo_mondayAt18 and crtTo_mondayCount == 2

// True Year Open: first bar of April (NY) — Q2 of the year cycle.
bool crtTo_isTrueYr = crtTo_nyMonth == 4 and crtTo_nyMonth[1] != 4

// ---- Storage: one current line+label per type ----
var array<line>  crtTo_asiaLn   = array.new<line>()
var array<label> crtTo_asiaLb   = array.new<label>()
var array<line>  crtTo_londonLn = array.new<line>()
var array<label> crtTo_londonLb = array.new<label>()
var array<line>  crtTo_nyamLn   = array.new<line>()
var array<label> crtTo_nyamLb   = array.new<label>()
var array<line>  crtTo_nypmLn   = array.new<line>()
var array<label> crtTo_nypmLb   = array.new<label>()
var array<line>  crtTo_dayLn    = array.new<line>()
var array<label> crtTo_dayLb    = array.new<label>()
var array<line>  crtTo_wkLn     = array.new<line>()
var array<label> crtTo_wkLb     = array.new<label>()
var array<line>  crtTo_moLn     = array.new<line>()
var array<label> crtTo_moLb     = array.new<label>()
var array<line>  crtTo_yrLn     = array.new<line>()
var array<label> crtTo_yrLb     = array.new<label>()

crtTo_create(array<line> _lns, array<label> _lbs, float _price, color _col, string _txt, string _tip) =>
    line _ln = line.new(bar_index, _price, bar_index, _price,
         color=_col, width=crtTo_lineWidth, style=crtTo_lineStyle, extend=extend.none)
    array.push(_lns, _ln)
    if crtTo_showLabels
        label _lb = label.new(bar_index + crtTo_labelGap, _price, _txt,
             color=color.new(_col, 100), textcolor=_col,
             style=label.style_label_left, size=size.small, tooltip=_tip)
        array.push(_lbs, _lb)
    while array.size(_lns) > 1
        line.delete(array.shift(_lns))
    while array.size(_lbs) > 1
        label.delete(array.shift(_lbs))

crtTo_extend(array<line> _lns, array<label> _lbs) =>
    if array.size(_lns) > 0
        line.set_x2(array.get(_lns, 0), bar_index)
    if array.size(_lbs) > 0
        label.set_x(array.get(_lbs, 0), bar_index + crtTo_labelGap)

// ---- Tooltips ----
string crtTo_tipAsia   = "True Session Open (Asia)\nDaye Quarterly Theory — Q2 open of the Asia session (19:30 NY)."
string crtTo_tipLondon = "True Session Open (London)\nDaye Quarterly Theory — Q2 open of the London session (01:30 NY)."
string crtTo_tipNYAM   = "True Session Open (NY AM)\nDaye Quarterly Theory — Q2 open of the NY AM session (07:30 NY)."
string crtTo_tipNYPM   = "True Session Open (NY PM)\nDaye Quarterly Theory — Q2 open of the NY PM session (13:30 NY)."
string crtTo_tipDay    = "True Day Open\nDaye Quarterly Theory — Q2 open of the daily cycle (00:00 NY).\nThe day begins 18:00 NY; this is where Q1 → Q2 transitions."
string crtTo_tipWeek   = "True Week Open\nDaye Quarterly Theory — Q2 open of the weekly cycle (Mon 18:00 NY)."
string crtTo_tipMonth  = "True Month Open\nDaye Quarterly Theory — Q2 open of the monthly cycle (2nd Monday 18:00 NY)."
string crtTo_tipYear   = "True Year Open\nDaye Quarterly Theory — Q2 open of the yearly cycle (April 1, 00:00 NY).\nYear quarters: Q1 Jan-Mar, Q2 Apr-Jun, Q3 Jul-Sep, Q4 Oct-Dec."

// ---- Plot ----
if crtTo_showSessions and crtTo_isAsia
    crtTo_create(crtTo_asiaLn,   crtTo_asiaLb,   open, crtTo_sessionColor, "TSO Asia",   crtTo_tipAsia)
if crtTo_showSessions and crtTo_isLondon
    crtTo_create(crtTo_londonLn, crtTo_londonLb, open, crtTo_sessionColor, "TSO London", crtTo_tipLondon)
if crtTo_showSessions and crtTo_isNYAM
    crtTo_create(crtTo_nyamLn,   crtTo_nyamLb,   open, crtTo_sessionColor, "TSO NY AM",  crtTo_tipNYAM)
if crtTo_showSessions and crtTo_isNYPM
    crtTo_create(crtTo_nypmLn,   crtTo_nypmLb,   open, crtTo_sessionColor, "TSO NY PM",  crtTo_tipNYPM)
if crtTo_showDay   and crtTo_isTrueDay
    crtTo_create(crtTo_dayLn, crtTo_dayLb, open, crtTo_dayColor,   "TDO", crtTo_tipDay)
if crtTo_showWeek  and crtTo_isTrueWk
    crtTo_create(crtTo_wkLn,  crtTo_wkLb,  open, crtTo_weekColor,  "TWO", crtTo_tipWeek)
if crtTo_showMonth and crtTo_isTrueMo
    crtTo_create(crtTo_moLn,  crtTo_moLb,  open, crtTo_monthColor, "TMO", crtTo_tipMonth)
if crtTo_showYear  and crtTo_isTrueYr
    crtTo_create(crtTo_yrLn,  crtTo_yrLb,  open, crtTo_yearColor,  "TYO", crtTo_tipYear)

// Stretch each line to the current bar and reposition its label every bar.
crtTo_extend(crtTo_asiaLn,   crtTo_asiaLb)
crtTo_extend(crtTo_londonLn, crtTo_londonLb)
crtTo_extend(crtTo_nyamLn,   crtTo_nyamLb)
crtTo_extend(crtTo_nypmLn,   crtTo_nypmLb)
crtTo_extend(crtTo_dayLn,    crtTo_dayLb)
crtTo_extend(crtTo_wkLn,     crtTo_wkLb)
crtTo_extend(crtTo_moLn,     crtTo_moLb)
crtTo_extend(crtTo_yrLn,     crtTo_yrLb)

// Lightweight price tracking for the dashboard's Day/Week bias row below —
// independent of the line/label objects above (and of their show/hide
// toggles), just the raw open price of the most recent True Day/Week Open.
var float crtTo_dayOpenPrice  = na
var float crtTo_weekOpenPrice = na
if crtTo_isTrueDay
    crtTo_dayOpenPrice := open
if crtTo_isTrueWk
    crtTo_weekOpenPrice := open

//================================================================
//  CISD
//=======================================================================

// - - - - - - - - -
// Input Groups
string g_general       = "1. ⚙️ General"
string g_cisd          = "2. 🔥 CISD Detection"
string g_cisd_fib      = "2.2. 🧪 CISD Fibonacci Projections"

// - - - - - - - - -
// Constants
color primBullCol   = #00a2c7
color primBearCol   = #db5755
color C_TRANSPARENT = color.new(color.white, 100)

// - - - - - - - - -
// DEV KILL SWITCH — Fibonacci engine
// Set to false to completely block ALL Fibonacci computation & drawing (for
// ports that only need CISD lines). The fib inputs remain visible but do
// nothing, and no fib code path executes. Keep true to run the full engine.
const bool CISD_FIB_ENGINE = true

// Minimum spacing between consecutive CISD Fibonacci projections in the SAME
// direction, on sub-1h charts only. Clustered CISDs would otherwise FIFO-evict a
// well-placed recent fib; enforcing a gap keeps them scarce like they naturally
// are on higher timeframes. Per direction — a bullish fib never blocks a bearish
// one. Applies only when the chart timeframe is under 1 hour.
const int CISD_FIB_MIN_SPACING_MS = 2 * 60 * 60 * 1000

// Pivot detection is unified at length 1 (most sensitive) so bar indices match
// between detection and invalidation — required for correct CISD removal.
int  pivot_len              = 1
bool pivot_delete_on_cross  = true
// Confirmed CISDs are cleaned up when price trades back through their pivot.
bool cisd_invalidate_on_cross = true

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// ▼▼▼ CISD ENGINE — TYPES ▼▼▼
// - - - - - - - - -

// CISD Stretch — the initial opposing candle run that precedes the pivot.
type CISDStretch
    bool  bullish             // true = bearish stretch preceded a bullish pivot
    int   origin_bar          // Bar index of stretch origin (furthest back)
    float level               // Price level (origin open) — the CISD line level
    int   end_bar             // Bar index of stretch end (closest to pivot)
    float end_close           // Close price at stretch end
    float origin_high         // High at origin bar (wick-mode origin side)
    float origin_low          // Low at origin bar (wick-mode origin side)
    // True reversal extreme of the WHOLE opposing move (not just the last
    // opposing candle). For a bullish CISD this is the lowest low; for a
    // bearish CISD the highest high — including candles that ran past the
    // opposing body run before the pivot formed. Wick-mode fibs project from it.
    int   run_ext_bar
    float run_ext_price

// Pending CISD — awaiting a confirmation candle.
type PendingCISD
    CISDStretch stretch
    int   pivot_bar           // Bar index of the pivot that triggered this CISD
    int   start_bar           // Bar when pending tracking started
    line  pending_line        // Dashed line for pending state

// Confirmed CISD — a candle closed beyond the stretch level.
type ConfirmedCISD
    CISDStretch stretch
    int   pivot_bar
    float pivot_price         // Pivot price level (for invalidation cleanup)
    int   confirmation_bar
    line  confirmed_line
    label confirm_shape
    bool  is_invalidated = false // Kept for historical display when exhaustive

// Pivot Data — active pivots tracked for CISD invalidation.
type PivotData
    int   bar_idx
    float price
    bool  is_high
    bool  has_purge

// Purge Tracking — internal filter for CISD (no visuals).
type PurgeTracker
    int   pivot_bar
    bool  is_high
    int   purge_bar

// CISD Fibonacci Projection — the fib lines/labels for a confirmed CISD.
type CISDFibProjection
    int   cisd_pivot_bar
    bool  is_bullish
    array<line>  fib_lines
    array<label> fib_labels
    int   confirmation_bar = 0
    int   confirmation_time = 0    // Chart time (ms) at confirmation — for spacing

// - - - - - - - - -
// CISD and Pivot Arrays
var array<PendingCISD>      pending_cisd        = array.new<PendingCISD>()
var array<ConfirmedCISD>    confirmed_cisd      = array.new<ConfirmedCISD>()
var array<CISDFibProjection> cisd_fib_projections = array.new<CISDFibProjection>()
var array<PivotData>        pivot_highs         = array.new<PivotData>()
var array<PivotData>        pivot_lows          = array.new<PivotData>()
var array<PurgeTracker>     purge_tracker       = array.new<PurgeTracker>()

// - - - - - - - - -
// CISD ENGINE — HELPERS (no input dependency; safe to hoist)

// Delete a fib projection's visuals.
deleteFibProjection(fp) =>
    if array.size(fp.fib_lines) > 0
        for i = 0 to array.size(fp.fib_lines) - 1
            line.delete(array.get(fp.fib_lines, i))
    if array.size(fp.fib_labels) > 0
        for i = 0 to array.size(fp.fib_labels) - 1
            label.delete(array.get(fp.fib_labels, i))

// Remove fib projection(s) linked to a CISD pivot bar, in ONE direction only —
// a wide-range candle can be a pivot high AND low at once, so both directions
// can share a pivot bar and a bar-only match would kill the wrong side.
removeFibProjectionByPivotBar(pivotBar, bool bullish) =>
    if array.size(cisd_fib_projections) > 0
        for i = array.size(cisd_fib_projections) - 1 to 0
            fp = array.get(cisd_fib_projections, i)
            if fp.cisd_pivot_bar == pivotBar and fp.is_bullish == bullish
                deleteFibProjection(fp)
                array.remove(cisd_fib_projections, i)

// Remove any CISD (pending or confirmed) linked to a pivot bar, in ONE
// direction only. A pivot-high invalidation must clear bearish CISDs alone
// (bullish = false); a pivot-low invalidation bullish alone (bullish = true).
removeCISDByPivotBar(pivotBar, bool bullish) =>
    if array.size(pending_cisd) > 0
        for i = array.size(pending_cisd) - 1 to 0
            item = array.get(pending_cisd, i)
            if item.pivot_bar == pivotBar and item.stretch.bullish == bullish
                line.delete(item.pending_line)
                array.remove(pending_cisd, i)
    if array.size(confirmed_cisd) > 0
        for i = array.size(confirmed_cisd) - 1 to 0
            ci = array.get(confirmed_cisd, i)
            if ci.pivot_bar == pivotBar and ci.stretch.bullish == bullish
                line.delete(ci.confirmed_line)
                label.delete(ci.confirm_shape)
                array.remove(confirmed_cisd, i)
    removeFibProjectionByPivotBar(pivotBar, bullish)

// Purge match within tolerance. A bullish CISD (from a low pivot) needs a low
// purge; a bearish CISD (from a high pivot) needs a high purge.
hasPurgeForCISD(pivotBar, bullishCISD, tolerance) =>
    bool hasPurge = false
    if array.size(purge_tracker) > 0
        for i = 0 to array.size(purge_tracker) - 1
            pt = array.get(purge_tracker, i)
            int barDistance = math.abs(pivotBar - pt.purge_bar)
            if barDistance <= tolerance
                if bullishCISD and not pt.is_high
                    hasPurge := true
                else if not bullishCISD and pt.is_high
                    hasPurge := true
    hasPurge

// Propulsion block: a confirming CISD whose run extreme has traded back INTO a
// previous SAME-direction, still-uninvalidated CISD's order block — the zone
// between that CISD's line level and its pivot — without breaking the pivot
// (which would already have removed it). Price dipped to the earlier line, held,
// and expanded again in the same direction to form this new CISD, propelling off
// it. Only confirmed CISDs still in the array are scanned, so "uninvalidated" is
// implicit. The source CISD must have confirmed at or before this CISD's run
// extreme (age >= 0 — it had to exist for price to trade into it) and within
// maxAge bars of that extreme (same window as the pending-CISD timeout) — older
// CISDs are stale and no longer counted. Returns true if this CISD is a
// propulsion block.
isPropulsionBlock(bool bullish, float extreme, int extremeBar, int maxAge) =>
    bool prop = false
    if array.size(confirmed_cisd) > 0
        for i = 0 to array.size(confirmed_cisd) - 1
            ci = array.get(confirmed_cisd, i)
            int age = extremeBar - ci.confirmation_bar
            if ci.stretch.bullish == bullish and age >= 0 and age <= maxAge
                float zTop = math.max(ci.stretch.level, ci.pivot_price)
                float zBot = math.min(ci.stretch.level, ci.pivot_price)
                if extreme >= zBot and extreme <= zTop
                    prop := true
                    break
    prop

// Count fib projections in a direction.
countFibProjections(isBullish) =>
    int count = 0
    if array.size(cisd_fib_projections) > 0
        for i = 0 to array.size(cisd_fib_projections) - 1
            fp = array.get(cisd_fib_projections, i)
            if fp.is_bullish == isBullish
                count += 1
    count

// Most recent fib confirmation time (ms) in a direction; 0 if none. Scans the
// live array, so fibs already removed (invalidated / trimmed) don't gate.
mostRecentFibTime(isBullish) =>
    int t = 0
    if array.size(cisd_fib_projections) > 0
        for i = 0 to array.size(cisd_fib_projections) - 1
            fp = array.get(cisd_fib_projections, i)
            if fp.is_bullish == isBullish and fp.confirmation_time > t
                t := fp.confirmation_time
    t

// Remove the oldest fib in a direction. Returns true if one was removed.
removeOldestFibForDir(isBull) =>
    int idx = -1
    if array.size(cisd_fib_projections) > 0
        for i = 0 to array.size(cisd_fib_projections) - 1
            fp = array.get(cisd_fib_projections, i)
            if fp.is_bullish == isBull
                idx := i
                break
    if idx >= 0
        deleteFibProjection(array.get(cisd_fib_projections, idx))
        array.remove(cisd_fib_projections, idx)
        true
    else
        false

// Enforce max fib projections per direction (FIFO, newest wins).
enforceFibMax(maxPerDirection) =>
    while countFibProjections(true) > maxPerDirection
        if not removeOldestFibForDir(true)
            break
    while countFibProjections(false) > maxPerDirection
        if not removeOldestFibForDir(false)
            break

// - - - - - - - - -
// ▲▲▲ CISD ENGINE — HELPERS (continued after inputs) ▲▲▲
// - - - - - - - - -

// - - - - - - - - -
// Inputs — General
string cisd_bias = input.string('Auto', '🔥 CISD Directional Bias', options = ['Auto', 'Bullish', 'Bearish'], group = g_general, tooltip = "Filter CISD detection by direction.\nAuto: detect both bullish and bearish.\nBullish: only bullish CISD.\nBearish: only bearish CISD.")

// - - - - - - - - -
// Inputs — CISD Detection
bool  inp_cisd_show    = input.bool(true, '🔥 Show CISD     ', inline = 'cisd_main', group = g_cisd)
bool  cisd_runtime_show = inp_cisd_show
color cisd_color_bull  = input.color(color.new(primBullCol, 0), '', inline = 'cisd_main', group = g_cisd, active = cisd_runtime_show)
color cisd_color_bear  = input.color(color.new(primBearCol, 0), '', inline = 'cisd_main', group = g_cisd, active = cisd_runtime_show)
int   cisd_offset      = input.int(2, '', minval = 0, maxval = 20, inline = 'cisd_main', group = g_cisd, active = cisd_runtime_show, tooltip = "Toggle: Show CISD lines.\nColors: Bullish / Bearish.\nOffset: Bars to extend line.")

string cisd_sensitivity = input.string('Standard', 'CISD Sensitivity', options = ['Standard', 'Max'], group = g_cisd, tooltip = "How many bars a pending CISD waits for a confirmation candle to close beyond the stretch level.\nStandard: 10 bar timeout.\nMax: 20 bar timeout (catches slower confirmations).", active = cisd_runtime_show)
int    cisd_pending_timeout = cisd_sensitivity == 'Standard' ? 10 : 20
bool   cisd_size_filter = input.bool(true, 'CISD Size Filter', inline = 'cisd_size', group = g_cisd, active = cisd_runtime_show)
string cisd_size_preset = input.string('Regular', '', options = ['Really small', 'Small', 'Regular', 'Sizeable', 'Juicy'], inline = 'cisd_size', group = g_cisd, active = cisd_runtime_show and cisd_size_filter, tooltip = "Toggle: Filter out small CISDs using ATR(14).\nPreset: Minimum stretch size relative to ATR.\nSmaller presets catch more CISDs. Larger presets only show significant moves.")
bool   cisd_exhaustive  = input.bool(false, 'Show All Historical CISD?', group = g_cisd, tooltip = "When this setting is on, invalidated CISDs stay on the chart as dashed lines.", active = cisd_runtime_show)
bool   cisd_purge_filter = input.bool(false, 'Filter by Purge', inline = 'cisd_purge', group = g_cisd, active = cisd_runtime_show)
int    cisd_purge_tolerance = input.int(5, '', minval = 1, maxval = 50, inline = 'cisd_purge', group = g_cisd, active = cisd_runtime_show and cisd_purge_filter, tooltip = "Toggle: Only create CISD after matching purge.\nTolerance: Max bars between pivot and purge.")

// - - - - - - - - -
// Inputs — CISD Fibonacci Projections  (all inert when CISD_FIB_ENGINE = false)
bool   cisd_fib_show_raw = input.bool(false, '🧪 Show Fibonacci Projections', group = g_cisd_fib, tooltip = "Draw Fibonacci extension levels from the CISD stretch.\nDev note: master-gated by the CISD_FIB_ENGINE kill switch in code.", active = cisd_runtime_show)
string cisd_fib_mode   = input.string('Body', 'Calculate From', options = ['Body', 'Wick'], group = g_cisd_fib, tooltip = "Use candle bodies or wicks for Fibonacci calculations.\nWick mode projects from the TRUE peak/trough of the whole opposing move.", active = cisd_runtime_show and cisd_fib_show_raw)
int    cisd_fib_max    = input.int(5, 'Max Fibs Per Direction', minval = 1, maxval = 10, group = g_cisd_fib, tooltip = "Maximum number of CISD Fibonacci projections to show per direction (bullish/bearish).", active = cisd_runtime_show and cisd_fib_show_raw)

// Fib level toggles with colors (0 and 1 are always shown as reference).
color cisd_fib_n05_color = input.color(color.new(#4a4a4a, 0), '', inline = 'fib_n05', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n05       = input.bool(false, '-0.5', inline = 'fib_n05', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
color cisd_fib_n10_color = input.color(color.new(#4a4a4a, 0), '', inline = 'fib_n05', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n10       = input.bool(false, '-1   ', inline = 'fib_n05', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
color cisd_fib_n15_color = input.color(color.new(#4a4a4a, 0), '', inline = 'fib_n05', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n15       = input.bool(false, '-1.5', inline = 'fib_n05', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)

color cisd_fib_n20_color = input.color(color.new(#4a4a4a, 0), '', inline = 'fib_n20', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n20       = input.bool(true, '-2 ', inline = 'fib_n20', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
color cisd_fib_n25_color = input.color(color.new(primBearCol, 0), '', inline = 'fib_n20', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n25       = input.bool(true, '-2.5  ', inline = 'fib_n20', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
color cisd_fib_n30_color = input.color(color.new(#4a4a4a, 0), '', inline = 'fib_n20', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n30       = input.bool(false, '-3  ', inline = 'fib_n20', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)

color cisd_fib_n35_color = input.color(color.new(#4a4a4a, 0), '', inline = 'fib_n35', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n35       = input.bool(false, '-3.5', inline = 'fib_n35', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
color cisd_fib_n40_color = input.color(color.new(primBearCol, 0), '', inline = 'fib_n35', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n40       = input.bool(true, '-4   ', inline = 'fib_n35', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
color cisd_fib_n45_color = input.color(color.new(#4a4a4a, 0), '', inline = 'fib_n35', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)
bool  cisd_fib_n45       = input.bool(true, '-4.5 ', inline = 'fib_n35', group = g_cisd_fib, active = cisd_runtime_show and cisd_fib_show_raw)

// Master fib gate — user toggle AND dev kill switch.
bool cisd_fib_show = CISD_FIB_ENGINE and cisd_fib_show_raw

// - - - - - - - - -
// Resolved bias
var bool BIAS_BEAR = cisd_bias == 'Auto' or cisd_bias == 'Bearish'
var bool BIAS_BULL = cisd_bias == 'Auto' or cisd_bias == 'Bullish'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// ▼▼▼ CISD ENGINE — CORE FUNCTIONS ▼▼▼
// - - - - - - - - -

// Candle direction helpers
isBullBody(i) => close[i] > open[i]
isBearBody(i) => close[i] < open[i]

// CISD ATR + size preset
float cisd_atr = ta.atr(14)
getCISDMinATRMult(preset) =>
    preset == 'Really small' ? 0.1 : preset == 'Small' ? 0.25 : preset == 'Sizeable' ? 0.66 : preset == 'Juicy' ? 1.0 : 0.5

// Compute the initial opposing stretch for a new pivot.
// Returns: [originOffset, level, endOffset, endClose, passesFilter,
//           originHigh, originLow, runExtOffset, runExtPrice]
// Walks back through same-direction candles to find the opposing run, then
// scans the whole origin→pivot span for the TRUE reversal extreme (run_ext).
computeInitialStretch(bullishPivot, pivotOffset, sizeFilter, atrMult) =>
    maxScan = 300
    if bullishPivot
        // Bullish pivot (from a low): need a bearish stretch before it.
        // Phase 1: walk back to the FIRST bear candle (skip bull/doji after pivot).
        endOffset = -1
        for k = pivotOffset to pivotOffset + maxScan
            if isBearBody(k)
                endOffset := k
                break
        if endOffset == -1
            [0, 0.0, 0, 0.0, false, 0.0, 0.0, 0, 0.0]
        else
            // Phase 2: continue back through consecutive bear candles.
            originOffset = endOffset
            for k = endOffset + 1 to endOffset + maxScan
                if isBearBody(k)
                    originOffset := k
                else
                    break
            // Run extreme: lowest low across the whole origin→pivot span.
            int   runExtOff = pivotOffset
            float runExtLow = low[pivotOffset]
            for k = pivotOffset to originOffset
                if low[k] < runExtLow
                    runExtLow := low[k]
                    runExtOff := k
            stretchBodySize = math.abs(open[originOffset] - close[endOffset])
            minStretchSize  = cisd_atr * atrMult
            passesFilter    = sizeFilter ? stretchBodySize >= minStretchSize : true
            [originOffset, open[originOffset], endOffset, close[endOffset], passesFilter, high[originOffset], low[originOffset], runExtOff, runExtLow]
    else
        // Bearish pivot (from a high): need a bullish stretch before it.
        endOffset = -1
        for k = pivotOffset to pivotOffset + maxScan
            if isBullBody(k)
                endOffset := k
                break
        if endOffset == -1
            [0, 0.0, 0, 0.0, false, 0.0, 0.0, 0, 0.0]
        else
            originOffset = endOffset
            for k = endOffset + 1 to endOffset + maxScan
                if isBullBody(k)
                    originOffset := k
                else
                    break
            // Run extreme: highest high across the whole origin→pivot span.
            int   runExtOff  = pivotOffset
            float runExtHigh = high[pivotOffset]
            for k = pivotOffset to originOffset
                if high[k] > runExtHigh
                    runExtHigh := high[k]
                    runExtOff  := k
            stretchBodySize = math.abs(open[originOffset] - close[endOffset])
            minStretchSize  = cisd_atr * atrMult
            passesFilter    = sizeFilter ? stretchBodySize >= minStretchSize : true
            [originOffset, open[originOffset], endOffset, close[endOffset], passesFilter, high[originOffset], low[originOffset], runExtOff, runExtHigh]

// Recompute a pending CISD's stretch if the opposing move extends this bar.
// Returns: [updated, originBar, level, endBar, endClose, runExtBar, runExtPrice]
recomputeStretchIfExtended(PendingCISD p) =>
    _bull = p.stretch.bullish
    if _bull and isBearBody(0) and close < p.stretch.end_close
        float newExtPx  = math.min(p.stretch.run_ext_price, low)
        int   newExtBar = low < p.stretch.run_ext_price ? bar_index : p.stretch.run_ext_bar
        [true, p.stretch.origin_bar, p.stretch.level, bar_index, close, newExtBar, newExtPx]
    else if (not _bull) and isBullBody(0) and close > p.stretch.end_close
        float newExtPx  = math.max(p.stretch.run_ext_price, high)
        int   newExtBar = high > p.stretch.run_ext_price ? bar_index : p.stretch.run_ext_bar
        [true, p.stretch.origin_bar, p.stretch.level, bar_index, close, newExtBar, newExtPx]
    else
        [false, p.stretch.origin_bar, p.stretch.level, p.stretch.end_bar, p.stretch.end_close, p.stretch.run_ext_bar, p.stretch.run_ext_price]

// Draw one CISD fib level (line + label).
drawCisdFibLevel(bool enabled, float multiplier, color lvlColor, string lvlText, int startBar, int endBar, float endPrice, float fibDirection, color transpColor, array<line> fibLines, array<label> fibLabels) =>
    if enabled
        float price = endPrice + (fibDirection * multiplier)
        ln  = line.new(startBar, price, endBar, price, color = lvlColor, style = line.style_solid, width = 1)
        array.push(fibLines, ln)
        if lvlText != ''
            lbl = label.new(startBar, price, lvlText, color = transpColor, style = label.style_label_right, textcolor = lvlColor, size = size.tiny, textalign = text.align_center)
            array.push(fibLabels, lbl)

// Render Fibonacci projections for a confirmed CISD.
//   Bullish CISD = bearish stretch (down), fibs project UPWARD.
//   Bearish CISD = bullish stretch (up),  fibs project DOWNWARD.
//   Wick mode projects the end side from run_ext (true peak/trough of the move).
renderCISDFibs(ci, useWick) =>
    CISDFibProjection result = na
    bool isBullishCISD = ci.stretch.bullish

    float originPrice = na
    float endPrice    = na
    if useWick
        if isBullishCISD
            originPrice := ci.stretch.origin_high
            endPrice    := ci.stretch.run_ext_price   // true trough of whole opposing move
        else
            originPrice := ci.stretch.origin_low
            endPrice    := ci.stretch.run_ext_price   // true peak of whole opposing move
    else
        originPrice := ci.stretch.level
        endPrice    := ci.stretch.end_close

    float stretchRange = endPrice - originPrice
    float fibDirection = -stretchRange   // extensions go opposite the stretch

    int startBar = ci.stretch.origin_bar
    int endBar   = ci.confirmation_bar

    array<line>  fibLines  = array.new<line>()
    array<label> fibLabels = array.new<label>()

    color transpColor = color.new(#ffffff, 100)
    color refColor    = color.new(#4a4a4a, 50)

    // Reference levels 0 and 1 (always drawn, reduced opacity).
    drawCisdFibLevel(true, 0.0, refColor, '', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(true, 1.0, refColor, '', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)

    // Configurable extension levels.
    drawCisdFibLevel(cisd_fib_n05, 1.5, cisd_fib_n05_color, '-0.5', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(cisd_fib_n10, 2.0, cisd_fib_n10_color, '-1', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(cisd_fib_n15, 2.5, cisd_fib_n15_color, '-1.5', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(cisd_fib_n20, 3.0, cisd_fib_n20_color, '-2', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(cisd_fib_n25, 3.5, cisd_fib_n25_color, '-2.5', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(cisd_fib_n30, 4.0, cisd_fib_n30_color, '-3', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(cisd_fib_n35, 4.5, cisd_fib_n35_color, '-3.5', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(cisd_fib_n40, 5.0, cisd_fib_n40_color, '-4', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)
    drawCisdFibLevel(cisd_fib_n45, 5.5, cisd_fib_n45_color, '-4.5', startBar, endBar, endPrice, fibDirection, transpColor, fibLines, fibLabels)

    result := CISDFibProjection.new(ci.pivot_bar, isBullishCISD, fibLines, fibLabels, confirmation_bar = ci.confirmation_bar, confirmation_time = time)
    result

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// ▼▼▼ CISD ENGINE — MAIN (pivot detection + CISD lifecycle) ▼▼▼
// - - - - - - - - -

float pivotHigh          = ta.pivothigh(pivot_len, pivot_len)
float pivotLow           = ta.pivotlow(pivot_len, pivot_len)
float cisd_atr_mult      = getCISDMinATRMult(cisd_size_preset)

// Register a detected pivot for CISD tracking / invalidation.
addPivot(float level, float price, bool isHigh, array<PivotData> arr) =>
    if bool(level)
        array.push(arr, PivotData.new(bar_index - pivot_len, price, isHigh, false))

addPivot(pivotHigh, high[pivot_len], true,  pivot_highs)
addPivot(pivotLow,  low[pivot_len],  false, pivot_lows)

// PIVOT HIGH INVALIDATION (price crosses through) → track purge, drop CISD.
if pivot_delete_on_cross and array.size(pivot_highs) > 0
    for i = array.size(pivot_highs) - 1 to 0
        pd = array.get(pivot_highs, i)
        if high > pd.price
            pt = PurgeTracker.new(pd.bar_idx, true, bar_index)
            array.push(purge_tracker, pt)
            pd.has_purge := true
            array.remove(pivot_highs, i)
            if cisd_runtime_show
                if cisd_exhaustive
                    // Bearish CISDs only — the pivot LOW side of the same bar
                    // may carry a live bullish CISD that this cross doesn't touch.
                    if array.size(confirmed_cisd) > 0
                        for j = array.size(confirmed_cisd) - 1 to 0
                            ci = array.get(confirmed_cisd, j)
                            if ci.pivot_bar == pd.bar_idx and not ci.stretch.bullish and not ci.is_invalidated
                                ci.is_invalidated := true
                                line.set_style(ci.confirmed_line, line.style_dashed)
                                line.set_width(ci.confirmed_line, 1)
                    if array.size(pending_cisd) > 0
                        for j = array.size(pending_cisd) - 1 to 0
                            item = array.get(pending_cisd, j)
                            if item.pivot_bar == pd.bar_idx and not item.stretch.bullish
                                line.delete(item.pending_line)
                                array.remove(pending_cisd, j)
                else
                    removeCISDByPivotBar(pd.bar_idx, false)

// PIVOT LOW INVALIDATION (price crosses through) → track purge, drop CISD.
if pivot_delete_on_cross and array.size(pivot_lows) > 0
    for i = array.size(pivot_lows) - 1 to 0
        pd = array.get(pivot_lows, i)
        if low < pd.price
            pt = PurgeTracker.new(pd.bar_idx, false, bar_index)
            array.push(purge_tracker, pt)
            pd.has_purge := true
            array.remove(pivot_lows, i)
            if cisd_runtime_show
                if cisd_exhaustive
                    // Bullish CISDs only — mirror of the pivot-high block above.
                    if array.size(confirmed_cisd) > 0
                        for j = array.size(confirmed_cisd) - 1 to 0
                            ci = array.get(confirmed_cisd, j)
                            if ci.pivot_bar == pd.bar_idx and ci.stretch.bullish and not ci.is_invalidated
                                ci.is_invalidated := true
                                line.set_style(ci.confirmed_line, line.style_dashed)
                                line.set_width(ci.confirmed_line, 1)
                    if array.size(pending_cisd) > 0
                        for j = array.size(pending_cisd) - 1 to 0
                            item = array.get(pending_cisd, j)
                            if item.pivot_bar == pd.bar_idx and item.stretch.bullish
                                line.delete(item.pending_line)
                                array.remove(pending_cisd, j)
                else
                    removeCISDByPivotBar(pd.bar_idx, true)

// CONFIRMED CISD INVALIDATION (price crosses back through the creation pivot).
if cisd_runtime_show and cisd_invalidate_on_cross and array.size(confirmed_cisd) > 0
    for i = array.size(confirmed_cisd) - 1 to 0
        ci = array.get(confirmed_cisd, i)
        if ci.is_invalidated
            continue
        bool shouldRemove = false
        if ci.stretch.bullish and low < ci.pivot_price
            shouldRemove := true
        else if not ci.stretch.bullish and high > ci.pivot_price
            shouldRemove := true
        if shouldRemove
            if cisd_exhaustive
                ci.is_invalidated := true
                line.set_style(ci.confirmed_line, line.style_dashed)
                line.set_width(ci.confirmed_line, 1)
                removeFibProjectionByPivotBar(ci.pivot_bar, ci.stretch.bullish)
            else
                line.delete(ci.confirmed_line)
                label.delete(ci.confirm_shape)
                array.remove(confirmed_cisd, i)
                removeFibProjectionByPivotBar(ci.pivot_bar, ci.stretch.bullish)

// CISD DETECTION — Pivot High creates a bearish CISD.
if cisd_runtime_show and bool(pivotHigh) and BIAS_BEAR
    [originOff, lvl, endOff, endCls, stretchPassesFilter, origH, origL, runExtOff, runExtPx] = computeInitialStretch(false, pivot_len, cisd_size_filter, cisd_atr_mult)
    origin_bar  = bar_index - originOff
    end_bar     = bar_index - endOff
    run_ext_bar = bar_index - runExtOff
    pivot_bar   = bar_index - pivot_len
    purge_ok    = not cisd_purge_filter or hasPurgeForCISD(pivot_bar, false, cisd_purge_tolerance)
    if stretchPassesFilter and purge_ok
        // Newest-wins: evict any same-direction pending incumbent, then create.
        if array.size(pending_cisd) > 0
            for ii = array.size(pending_cisd) - 1 to 0
                it = array.get(pending_cisd, ii)
                if not it.stretch.bullish
                    line.delete(it.pending_line)
                    array.remove(pending_cisd, ii)
        ln = line.new(origin_bar, lvl, bar_index, lvl, color = cisd_color_bear, style = line.style_dotted, width = 1)
        st = CISDStretch.new(false, origin_bar, lvl, end_bar, endCls, origH, origL, run_ext_bar, runExtPx)
        array.push(pending_cisd, PendingCISD.new(st, pivot_bar, bar_index, ln))

// CISD DETECTION — Pivot Low creates a bullish CISD.
if cisd_runtime_show and bool(pivotLow) and BIAS_BULL
    [originOffB, lvlB, endOffB, endClsB, stretchPassesFilterB, origHB, origLB, runExtOffB, runExtPxB] = computeInitialStretch(true, pivot_len, cisd_size_filter, cisd_atr_mult)
    origin_bar_b  = bar_index - originOffB
    end_bar_b     = bar_index - endOffB
    run_ext_bar_b = bar_index - runExtOffB
    pivot_bar_b   = bar_index - pivot_len
    purge_ok_b    = not cisd_purge_filter or hasPurgeForCISD(pivot_bar_b, true, cisd_purge_tolerance)
    if stretchPassesFilterB and purge_ok_b
        // Newest-wins: evict any same-direction pending incumbent, then create.
        if array.size(pending_cisd) > 0
            for ii = array.size(pending_cisd) - 1 to 0
                it = array.get(pending_cisd, ii)
                if it.stretch.bullish
                    line.delete(it.pending_line)
                    array.remove(pending_cisd, ii)
        lnB = line.new(origin_bar_b, lvlB, bar_index, lvlB, color = cisd_color_bull, style = line.style_dotted, width = 1)
        stB = CISDStretch.new(true, origin_bar_b, lvlB, end_bar_b, endClsB, origHB, origLB, run_ext_bar_b, runExtPxB)
        array.push(pending_cisd, PendingCISD.new(stB, pivot_bar_b, bar_index, lnB))

// CISD RUNTIME — process pending CISDs (timeout, extend, confirm).
if cisd_runtime_show and array.size(pending_cisd) > 0
    for i = array.size(pending_cisd) - 1 to 0
        p = array.get(pending_cisd, i)
        // Timeout
        if bar_index - p.start_bar >= cisd_pending_timeout
            line.delete(p.pending_line)
            array.remove(pending_cisd, i)
            continue
        // Extend stretch if the opposing move continued this bar
        [updated, new_origin_bar, new_level, new_end_bar, new_end_close, new_run_ext_bar, new_run_ext_price] = recomputeStretchIfExtended(p)
        if updated
            line.set_x1(p.pending_line, new_origin_bar)
            line.set_y1(p.pending_line, new_level)
            line.set_y2(p.pending_line, new_level)
            p.stretch.origin_bar    := new_origin_bar
            p.stretch.level         := new_level
            p.stretch.end_bar       := new_end_bar
            p.stretch.end_close     := new_end_close
            p.stretch.run_ext_bar   := new_run_ext_bar
            p.stretch.run_ext_price := new_run_ext_price
            array.set(pending_cisd, i, p)
        line.set_x2(p.pending_line, bar_index)
        // Confirmation: close beyond the stretch level.
        confirm_ok = p.stretch.bullish ? close > p.stretch.level : close < p.stretch.level
        if confirm_ok
            x1_c = p.stretch.origin_bar
            x2_c = bar_index + cisd_offset
            y_c  = p.stretch.level
            // Propulsion block: run extreme traded into a prior same-direction
            // CISD's zone → thin 1px line (keeps bull/bear color) and no fibs below.
            bool isProp = isPropulsionBlock(p.stretch.bullish, p.stretch.run_ext_price, p.stretch.run_ext_bar, cisd_pending_timeout)
            cisdColor = p.stretch.bullish ? cisd_color_bull : cisd_color_bear
            ln_c = line.new(x1_c, y_c, x2_c, y_c, color = cisdColor, style = line.style_solid, width = isProp ? 1 : 2)
            yloc_ = p.stretch.bullish ? yloc.belowbar : yloc.abovebar
            shp = label.new(bar_index, close, style = label.style_circle, text = '', size = size.auto, color = C_TRANSPARENT, textcolor = cisdColor, yloc = yloc_)
            float pivotPriceForCISD = p.stretch.bullish ? low[bar_index - p.pivot_bar] : high[bar_index - p.pivot_bar]
            ci = ConfirmedCISD.new(p.stretch, p.pivot_bar, pivotPriceForCISD, bar_index, ln_c, shp)
            array.push(confirmed_cisd, ci)
            // Fibonacci projections — gated by the CISD_FIB_ENGINE kill switch.
            // Propulsion blocks draw no fibs (same rule as EntryCalc).
            // On sub-1h charts, enforce a per-direction spacing gap so clustered
            // CISDs don't FIFO-evict a well-placed recent fib.
            if cisd_fib_show and not isProp
                bool fib_spacing_ok = true
                if timeframe.in_seconds() < 3600
                    int lastFibTime = mostRecentFibTime(p.stretch.bullish)
                    if lastFibTime > 0 and time - lastFibTime < CISD_FIB_MIN_SPACING_MS
                        fib_spacing_ok := false
                if fib_spacing_ok
                    useWick = cisd_fib_mode == 'Wick'
                    fibProj = renderCISDFibs(ci, useWick)
                    if not na(fibProj)
                        array.push(cisd_fib_projections, fibProj)
                        enforceFibMax(cisd_fib_max)
            line.delete(p.pending_line)
            array.remove(pending_cisd, i)

// Cleanup old purge trackers (keep only last 100)
while array.size(purge_tracker) > 100
    array.shift(purge_tracker)

// - - - - - - - - -
// ▲▲▲ CISD ENGINE — END ▲▲▲



//================================================================
//  CRT MODEL DASHBOARD — clean compact table modeled on the supplied image.
//================================================================
string g_dashboard = "Dashboard"
bool showCRTDashboard = input.bool(true, "Show Dashboard", group=g_dashboard)
var table crtDash = table.new(position.top_right, 2, 5, border_width=1)

string crtDashBias = not na(c0) and not na(o0) ? (c0 > o0 ? "Bullish" : c0 < o0 ? "Bearish" : "Neutral") : "Neutral"
string crtDashPair = smt_pair != "" ? syminfo.ticker + " / " + smt_pair + " (" + smt_pair_selection + ")" : syminfo.ticker + " / — (" + smt_pair_selection + ")"
string crtDashMode = qtAlignment ? "QT Alignment" : "ICT"
string crtDashTf = not na(activeTimeframe) ? crtFormatTF(activeTimeframe) : "—"
string crtDashDate = str.format_time(time, "dd MMM yyyy", "America/New_York")

// True Open Day/Week bias row: on daily-and-above chart timeframes the True
// Day cycle is too granular to be a meaningful reference, so it switches to
// True Week Open; below that (intraday charts) it uses True Day Open.
bool  crtDashUseWeek   = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
float crtDashTORef     = crtDashUseWeek ? crtTo_weekOpenPrice : crtTo_dayOpenPrice
string crtDashTOLabel  = crtDashUseWeek ? "TWO" : "TDO"
string crtDashTOBias   = not na(crtDashTORef) ? (close > crtDashTORef ? "Above " + crtDashTOLabel : close < crtDashTORef ? "Below " + crtDashTOLabel : "At " + crtDashTOLabel) : "—"
color  crtDashTOColor  = not na(crtDashTORef) ? (close > crtDashTORef ? color.lime : close < crtDashTORef ? color.red : color.gray) : color.gray

if barstate.islast
    if showCRTDashboard
        table.cell(crtDash, 0, 0, "CRT Model (" + crtDashTf + ")", text_color=color.white, bgcolor=color.rgb(20, 23, 30), text_size=size.small)
        table.cell(crtDash, 1, 0, crtDashMode, text_color=color.white, bgcolor=color.rgb(20, 23, 30), text_size=size.small)
        table.cell(crtDash, 0, 1, crtDashTOLabel, text_color=color.gray, bgcolor=color.new(color.white, 0), text_size=size.tiny)
        table.cell(crtDash, 1, 1, crtDashTOBias, text_color=crtDashTOColor, bgcolor=color.new(color.white, 0), text_size=size.tiny)
        table.cell(crtDash, 0, 2, "Bias", text_color=color.gray, bgcolor=color.new(color.white, 0), text_size=size.tiny)
        table.cell(crtDash, 1, 2, crtDashBias, text_color=crtDashBias == "Bullish" ? color.lime : crtDashBias == "Bearish" ? color.red : color.gray, bgcolor=color.new(color.white, 0), text_size=size.tiny)
        table.cell(crtDash, 0, 3, "SMT", text_color=color.gray, bgcolor=color.new(color.white, 0), text_size=size.tiny)
        table.cell(crtDash, 1, 3, crtDashPair, text_color=color.gray, bgcolor=color.new(color.white, 0), text_size=size.tiny)
        table.cell(crtDash, 0, 4, "Date", text_color=color.gray, bgcolor=color.new(color.white, 0), text_size=size.tiny)
        table.cell(crtDash, 1, 4, crtDashDate, text_color=color.gray, bgcolor=color.new(color.white, 0), text_size=size.tiny)
    else
        for _r = 0 to 4
            table.cell(crtDash, 0, _r, "", bgcolor=color.new(color.white, 100))
            table.cell(crtDash, 1, _r, "", bgcolor=color.new(color.white, 100))
